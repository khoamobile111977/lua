local function getServersFromAPI()
    local servers = {}
    local cursor = ""
    local maxAttempts = 2
    local attempts = 0
    repeat
        attempts = attempts + 1
        local s, r = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(
                "https://games.roblox.com/v1/games/" .. game.PlaceId ..
                "/servers/Public?sortOrder=Asc&limit=100&cursor=" .. cursor
            ))
        end)
        if s and r and type(r) == "table" and r.data then
            for _, sv in pairs(r.data) do
                if type(sv) == "table" and sv.playing and sv.id
                    and sv.playing >= 1 and sv.playing <= 9
                    and sv.id ~= game.JobId then
                    table.insert(servers, sv)
                    if #servers >= 10 then break end
                end
            end
            cursor = r.nextPageCursor or ""
        else
            cursor = ""
        end
    until cursor == "" or #servers >= 10 or attempts >= maxAttempts
    return #servers > 0 and servers or nil
end

local function getServersFromBrowser()
    local collectedServers = {}
    for page = 1, 100 do
        local success, data = pcall(function()
            return ServerBrowser:InvokeServer(page)
        end)
        if success and type(data) == "table" then
            for jobId, info in pairs(data) do
                if jobId ~= game.JobId and type(info) == "table" then
                    table.insert(collectedServers, {id = jobId, playing = info.Count or 0})
                end
            end
            if #collectedServers >= 30 then break end
        end
        task.wait(0.05)
    end
    if #collectedServers > 0 then
        local filtered = {}
        for _, sv in ipairs(collectedServers) do
            if sv.playing >= 1 and sv.playing <= 9 then
                table.insert(filtered, sv)
            end
        end
        table.sort(filtered, function(a, b) return a.playing < b.playing end)
        local top10 = {}
        for i = 1, math.min(10, #filtered) do
            table.insert(top10, filtered[i])
        end
        return #top10 > 0 and top10 or nil
    end
    return nil
end

local function HopServer()
    StatusUI:Update("🔍 Finding server...", "HOPPING")
    local TeleportService = game:GetService("TeleportService")
    local teleportFailed = false
    local conn = TeleportService.TeleportInitFailed:Connect(function()
        teleportFailed = true
    end)

    while true do
        local servers = getServersFromAPI()
        if not servers or #servers == 0 then
            StatusUI:Update("⚠️ API limited, dùng fallback...", "HOPPING")
            servers = getServersFromBrowser()
        end

        if servers and #servers > 0 then
            local pick = servers[math.random(1, #servers)]
            StatusUI:Update("🚀 Đang join server...", "HOPPING")
            teleportFailed = false
            pcall(function() ServerBrowser:InvokeServer("teleport", pick.id) end)

            local waited = 0
            while waited < 15 do
                if teleportFailed then break end
                task.wait(1)
                waited = waited + 1
            end

            if teleportFailed then
                StatusUI:Update("❌ Join thất bại, thử server khác...", "HOPPING")
            else
                StatusUI:Update("⏳ Vẫn ở đây, tìm server mới...", "HOPPING")
            end
        else
            StatusUI:Update("❌ Không tìm được server, chờ 10s...", "HOPPING")
            task.wait(10)
        end
    end

    if conn then conn:Disconnect() end
end
