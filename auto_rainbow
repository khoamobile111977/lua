local questCount = 0

local function MainLoop()
    while true do
        local char, hrp, hum = GetCharacter()
        if not char then
            StatusUI:Update("Waiting for character...")
            task.wait(2)
            continue
        end

        StatusUI:Update("Accepting quest...", "N/A")
        AcceptQuest()
        task.wait(5)

        local bossName = GetQuestBossName()
        if not bossName then
            StatusUI:Update("No quest available - Rainbow Haki complete!", "Done ✓")
            task.wait(5)
            AcceptQuest()
            task.wait(5)
            bossName = GetQuestBossName()
            if not bossName then
                StatusUI:Update("🎉 All quests completed!", "Done ✓")
                break
            end
        end

        questCount = questCount + 1
        StatusUI:Update("Quest accepted!", bossName, questCount)
        task.wait(1)

        local bossDefeated = false

        while not bossDefeated do
            char, hrp, hum = GetCharacter()
            if not char then
                MeleeEquipped = false
                StatusUI:Update("Respawning...")
                task.wait(5)
                continue
            end

            local bossEntity, sourceType = FindBoss(bossName)

            if not bossEntity then
                StatusUI:Update("❌ Không thấy " .. bossName .. " → Hopping!", bossName)
                HopServer()
                return
            end

            if sourceType == "EnemySpawns" then
                StatusUI:Update("Tweening to " .. bossName .. " spawn...")
                local spawnPos = bossEntity:IsA("Model")
                    and (bossEntity.PrimaryPart and bossEntity.PrimaryPart.CFrame or bossEntity:GetChildren()[1].CFrame)
                    or bossEntity.CFrame

                TweenTo(CFrame.new(spawnPos.Position + Vector3.new(0, 50, 0)))

                local bossFound = false
                while IsMoving do
                    local enemies = Workspace:FindFirstChild("Enemies")
                    if enemies then
                        local liveBoss = enemies:FindFirstChild(bossName)
                        if liveBoss and liveBoss:FindFirstChild("Humanoid") and liveBoss.Humanoid.Health > 0 and liveBoss:FindFirstChild("HumanoidRootPart") then
                            StopTween()
                            bossEntity = liveBoss
                            sourceType = "Enemies"
                            bossFound = true
                            break
                        end
                    end

                    char, hrp, hum = GetCharacter()
                    if not char then
                        StopTween()
                        break
                    end
                    task.wait(0.3)
                end

                if not bossFound and not char then continue end

                if not bossFound then
                    local boss = WaitForBossSpawn(bossName, bossEntity)
                    if boss then
                        bossEntity = boss
                        sourceType = "Enemies"
                    else
                        -- Spawn chờ quá lâu → hop server
                        StatusUI:Update("⏰ " .. bossName .. " không spawn → Hopping!", bossName)
                        task.wait(1)
                        HopServer()
                        return
                    end
                end
            end

            if sourceType == "Enemies" and bossEntity and bossEntity:FindFirstChild("Humanoid") and bossEntity.Humanoid.Health > 0 then
                StatusUI:Update("Fighting " .. bossName .. "!", bossName)

                if not MeleeEquipped then
                    EquipMelee()
                end

                while bossEntity and bossEntity.Parent and bossEntity:FindFirstChild("Humanoid") and bossEntity.Humanoid.Health > 0 do
                    char, hrp, hum = GetCharacter()
                    if not char then
                        MeleeEquipped = false
                        break
                    end

                    if not char:FindFirstChildOfClass("Tool") or (char:FindFirstChildOfClass("Tool") and char:FindFirstChildOfClass("Tool").ToolTip ~= "Melee") then
                        EquipMelee()
                    end

                    local bossHRP = bossEntity:FindFirstChild("HumanoidRootPart")
                    if bossHRP then
                        local targetCFrame = bossHRP.CFrame * CFrame.new(0, 50, 0)
                        local dist = (hrp.Position - bossHRP.Position).Magnitude
                        if dist > 70 then
                            TweenTo(targetCFrame)
                        else
                            StopTween()
                            hrp.CFrame = targetCFrame
                        end
                    end


                    FastAttackBoss(bossEntity)

                    pcall(function()
                        local hp = math.floor(bossEntity.Humanoid.Health)
                        local maxHp = math.floor(bossEntity.Humanoid.MaxHealth)
                        StatusUI:Update("⚔️ " .. bossName .. " [" .. hp .. "/" .. maxHp .. "]")
                    end)

                    task.wait(0.1)
                end

                if not bossEntity or not bossEntity.Parent or (bossEntity:FindFirstChild("Humanoid") and bossEntity.Humanoid.Health <= 0) then
                    bossDefeated = true
                    StopTween()
                    StatusUI:Update("✅ " .. bossName .. " defeated!", bossName)
                end
            end
        end

        StatusUI:Update("Waiting for next quest...")
        task.wait(5)
    end
end

