local CurrentTween = nil
local IsMoving = false
local MeleeEquipped = false
local AttackDebounce = 0

local function GetCharacter()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return nil end
    return char, hrp, hum
end

local function TweenTo(targetCFrame, speed)
    speed = getgenv().SpeedTween or 275
    local char, hrp = GetCharacter()
    if not char or not hrp then return false end

    if CurrentTween then
        pcall(function() CurrentTween:Cancel() end)
        CurrentTween = nil
    end

    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    if dist < 10 then
        hrp.CFrame = targetCFrame
        return true
    end

    local tweenTime = math.max(0.3, dist / speed)
    local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear)
    IsMoving = true
    CurrentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    CurrentTween.Completed:Connect(function()
        IsMoving = false
        CurrentTween = nil
    end)
    CurrentTween:Play()
    return true
end

local function StopTween()
    if CurrentTween then
        pcall(function() CurrentTween:Cancel() end)
        CurrentTween = nil
        IsMoving = false
    end
end

local function EquipMelee()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local currentTool = char:FindFirstChildOfClass("Tool")
        if currentTool and currentTool.ToolTip == "Melee" then
            MeleeEquipped = true
            return
        end
        for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do
            if v:IsA("Tool") and v.ToolTip == "Melee" then
                char:FindFirstChildOfClass("Humanoid"):EquipTool(v)
                MeleeEquipped = true
                return
            end
        end
    end)
end

local function FastAttackBoss(bossModel)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local weapon = char:FindFirstChildOfClass("Tool")
    if not weapon or weapon.ToolTip ~= "Melee" then return end

    local currentTime = tick()
    if currentTime - AttackDebounce < 0.1 then return end
    AttackDebounce = currentTime

    if not bossModel or not bossModel:FindFirstChild("HumanoidRootPart") then return end
    if not bossModel:FindFirstChild("Humanoid") or bossModel.Humanoid.Health <= 0 then return end

    local dist = (char.HumanoidRootPart.Position - bossModel.HumanoidRootPart.Position).Magnitude
    if dist > 60 then return end

    local hitPart = bossModel:FindFirstChild("Head") or bossModel.HumanoidRootPart
    local hitTargets = {{bossModel, hitPart}}

    pcall(function()
        SendAttack(0.1, {hitPart, hitTargets})
    end)
end

