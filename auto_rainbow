local function GetQuestBossName()
    local success, bossName = pcall(function()
        local gui = LocalPlayer.PlayerGui:FindFirstChild("Main")
        if not gui then return nil end
        local guide = gui:FindFirstChild("Guide")
        if not guide then return nil end
        local leftFrame = guide:FindFirstChild("LeftFrame")
        if not leftFrame then return nil end
        local iconFrame = leftFrame:FindFirstChild("IconFrame")
        if not iconFrame then return nil end
        local viewport = iconFrame:FindFirstChild("ViewportFrame")
        if not viewport then return nil end
        for _, child in pairs(viewport:GetChildren()) do
            if child:IsA("Model") or child:IsA("BasePart") then
                return child.Name
            end
        end
        return nil
    end)
    if success then return bossName end
    return nil
end

local function HasActiveQuest()
