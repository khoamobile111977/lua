        local gui = LocalPlayer.PlayerGui:FindFirstChild("Main")
        if not gui then return false end
        local guide = gui:FindFirstChild("Guide")
        if not guide then return false end
        return guide.Visible
    end)
    return success and result
end

local function FindBoss(bossName)
    if not bossName then return nil end

    local enemies = Workspace:FindFirstChild("Enemies")
    if enemies then
        local boss = enemies:FindFirstChild(bossName)
        if boss and boss:FindFirstChild("Humanoid") and boss.Humanoid.Health > 0 and boss:FindFirstChild("HumanoidRootPart") then
            return boss, "Enemies"
        end
    end

    local worldOrigin = Workspace:FindFirstChild("_WorldOrigin")
    if worldOrigin then
        local enemySpawns = worldOrigin:FindFirstChild("EnemySpawns")
        if enemySpawns then
            for _, spawn in pairs(enemySpawns:GetChildren()) do
                local spawnBossName = spawn.Name:match("^(.-)%s*%[")
                if spawnBossName and spawnBossName:match("^%s*(.-)%s*$") == bossName then
                    return spawn, "EnemySpawns"
                end
            end
        end
    end

    return nil, nil
end

local function WaitForBossSpawn(bossName, spawnPart)
    StatusUI:Update("Waiting for " .. bossName .. " to spawn...")

    local timeout = 60
    local startTime = tick()

    while tick() - startTime < timeout do
        local enemies = Workspace:FindFirstChild("Enemies")
        if enemies then
            local boss = enemies:FindFirstChild(bossName)
            if boss and boss:FindFirstChild("Humanoid") and boss.Humanoid.Health > 0 and boss:FindFirstChild("HumanoidRootPart") then
                return boss
            end
        end
        task.wait(0.5)
    end
    return nil
end

