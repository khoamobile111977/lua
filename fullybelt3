function checkFragments()
    local best = 0
    for attempt = 1, 3 do
        local val = 0
        pcall(function()
            local data = lp:FindFirstChild("Data") or lp:WaitForChild("Data", 3)
            if data then
                local f = data:FindFirstChild("Fragments") or data:WaitForChild("Fragments", 3)
                if f then val = f.Value end
            end
        end)
        if val > best then best = val end
        if best > 0 then break end
        if attempt < 3 then task.wait(0.5) end
    end
    return best
end

function getCurrentServerPlayers()
    return #Players:GetPlayers()
end

function getServerInfo(targetJobId)
    local cursor  = ""
    local attempts = 0
    repeat
        attempts = attempts + 1
        local ok, result = pcall(function()
            return HttpService:JSONDecode(
                game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId
                             .. "/servers/Public?sortOrder=Asc&limit=100&cursor=" .. cursor)
            )
        end)
        if ok and result and result.data then
            for _, sv in pairs(result.data) do
                if sv.id == targetJobId then
                    return sv.playing, sv.maxPlayers
                end
            end
            cursor = result.nextPageCursor or ""
        else
            wait(2)
        end
    until cursor == "" or attempts >= 3
    return nil, nil
end

function findLowPlayerServers(maxCount)
    maxCount   = maxCount or 10
    local cursor     = ""
    local candidates = {}
    local attempts   = 0

    repeat
        attempts = attempts + 1
        local ok, result = pcall(function()
            return HttpService:JSONDecode(
                game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId
                             .. "/servers/Public?sortOrder=Asc&limit=100&cursor=" .. cursor)
            )
        end)
        if ok and result and result.data then
            for _, sv in pairs(result.data) do
                if sv.playing and sv.id
                   and sv.playing >= 1 and sv.playing < MAX_SERVER_PLAYERS
                   and sv.id ~= game.JobId
                then
                    table.insert(candidates, { id = sv.id, players = sv.playing })
                    if #candidates >= maxCount then return candidates end
                end
            end
            cursor = result.nextPageCursor or ""
            if result.errors then break end
        else
            wait(2)
        end
    until cursor == "" or attempts >= 5

    return candidates
end

function findRandomServer()
    local cursor  = ""
    local pool    = {}
    local attempts = 0
    repeat
        attempts = attempts + 1
        local ok, result = pcall(function()
            return HttpService:JSONDecode(
                game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId
                             .. "/servers/Public?sortOrder=Asc&limit=100&cursor=" .. cursor)
            )
        end)
        if ok and result and result.data then
            for _, sv in pairs(result.data) do
                if sv.id and sv.id ~= game.JobId and sv.playing and sv.playing > 0 then
                    table.insert(pool, sv)
                end
            end
            cursor = result.nextPageCursor or ""
            if #pool >= 10 then break end
        else
            wait(2)
        end
    until cursor == "" or attempts >= 3
    if #pool > 0 then
        local r = pool[math.random(1, #pool)]
        return r.id, r.playing
    end
    return nil, 0
end

