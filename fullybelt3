-- ============================================================
--  FARM TYRANT  –  COORDINATION CẢI TIẾN
--
--  THUẬT TOÁN:
--  ─────────────────────────────────────────────────────────
--  Tất cả acc FARM_TYRANT dùng chung 1 file JSON để phối hợp.
--  File có trường `farm_tyrant_target` = job_id server mà TẤT CẢ
--  acc cần hop vào. Leader (acc tên nhỏ nhất alphabetically)
--  có quyền set/update target.
--
--  Flow cho mỗi acc:
--  1. Post state lên local server, chờ 3s cho acc khác post
--  2. Kiểm tra mình đang ở target → farm ngay
--  3. Đọc target từ file:
--     a. Target tồn tại + server < MAX_PLAYERS → join target
--     b. Target full hoặc không tồn tại:
--        - Là Leader  → tìm server ít người → set target → join
--        - Là Follower → chờ tối đa 60s cho leader set target
--          → Nếu hết giờ chưa có target → chọn sub-leader
--            (leader trong nhóm acc CHƯA vào được server)
--            → sub-leader tìm server mới → set target → join
--            → các acc còn lại join theo
--  ─────────────────────────────────────────────────────────
-- ============================================================
function handleFarmTyrant(mastery, fragments)

    -- Bước 0: Đăng ký lên local server (gửi số player hiện tại)
    local curCount = getCurrentServerPlayers()
    lsPost("FARM_TYRANT", game.JobId, curCount, game.JobId)
    updateStatus("FARM_TYRANT",
        "📡 Đăng ký + chờ các acc khác... (3s)\n"
        .. "👥 Server hiện tại: " .. curCount .. "/12 người")
    task.wait(3)

    -- ── Bước 0.5: Server hiện tại đủ 12 người rồi → PHẢI hop sang server khác ──
    curCount = getCurrentServerPlayers()
    if curCount >= MAX_SERVER_PLAYERS then
        updateStatus("FARM_TYRANT",
            "⚠️ Server hiện tại ĐẦY (" .. curCount .. "/12)!\n"
            .. "🔀 Chọn server khác trước khi farm...")
        task.wait(1)

        -- Xóa target cũ nếu có (vì target đó chính là server đang đầy)
        local existingTarget, _ = lsGetFarmTarget()
        if existingTarget == game.JobId then
            lsClearFarmTarget()
        end

        local amLeaderNow, leaderNameNow, _ = lsIsLeader()
        if amLeaderNow then
            -- Leader: tìm server có chỗ, set target mới rồi hop
            local candidates = findLowPlayerServers(10)
            if #candidates > 0 then
                local chosen = candidates[math.random(1, #candidates)]
                updateStatus("FARM_TYRANT",
                    "👑 Leader → Tìm được server (" .. chosen.players .. "/12)\n"
                    .. "🚀 Set target & Hop server...")
                lsSetFarmTarget(chosen.id, playerName)
                writeState("FARM_TYRANT", mastery, fragments, chosen.id)
                lsPost("FARM_TYRANT", chosen.id, chosen.players, chosen.id)
                task.wait(2)
                joinServerByJobId(chosen.id)
            else
                -- Không tìm được → rejoin random
                updateStatus("FARM_TYRANT",
                    "❌ Không tìm được server trống\n🔄 Rejoin ngẫu nhiên...")
                task.wait(2)
                TeleportService:Teleport(game.PlaceId, lp)
            end
        else
            -- Follower: chờ leader chọn server mới
            updateStatus("FARM_TYRANT",
                "⏳ Server đầy! Chờ leader " .. leaderNameNow .. " chọn server mới...")
            local waitedFull = 0
            while waitedFull < 45 do
                task.wait(5)
                waitedFull = waitedFull + 5
                local newT, _ = lsGetFarmTarget()
                if newT and newT ~= "" and newT ~= game.JobId then
                    local cp, _ = getServerInfo(newT)
                    if cp and cp < MAX_SERVER_PLAYERS then
                        updateStatus("FARM_TYRANT",
                            "✅ Leader set server mới (" .. cp .. "/12)\n🚀 Hop server...")
                        writeState("FARM_TYRANT", mastery, fragments, newT)
                        lsPost("FARM_TYRANT", newT, cp, newT)
                        task.wait(2)
                        joinServerByJobId(newT)
                        return
                    end
                end
                updateStatus("FARM_TYRANT",
                    "⏳ Server đầy (" .. curCount .. "/12) | Chờ... ("
                    .. waitedFull .. "/45s)")
            end
            -- Hết giờ → tự hop random
            updateStatus("FARM_TYRANT",
                "❌ Hết giờ chờ → Hop server ngẫu nhiên...")
            task.wait(2)
            TeleportService:Teleport(game.PlaceId, lp)
        end
        return
    end

    -- ── Bước 1: Mình đang ở đúng target rồi? ────────────────────────
    local targetJobId, targetSetBy = lsGetFarmTarget()
    if targetJobId and targetJobId == game.JobId then
        local accList = lsGetAccsSameServer()
        updateStatus("FARM_TYRANT",
            "✅ Đang ở target server!\n"
            .. "🤝 " .. #accList .. " acc cùng server → Farm!")
        task.wait(2)
        writeState("FARM_TYRANT", mastery, fragments, game.JobId)
        lsPost("FARM_TYRANT", game.JobId, getCurrentServerPlayers(), game.JobId)
        startMonitoring("FARM_TYRANT")
        executeConfig("FARM_TYRANT")
        return
    end

    -- ── Bước 1.5: [NEW] Phân tích trạng thái farm hiện tại ──────────
    --
    --  • Nếu đang farm MỘT MÌNH (không acc nào cùng server):
    --    → acc này CẦN HOP để tìm server farm chung
    --  • Nếu đã farm CÙNG nhau (có bạn đồng hành):
    --    → tiếp tục farm, không cần hop
    --
    --  Sau khi xác định cần hop:
    --  1) Ưu tiên join server đang có acc farm còn chỗ (từ local file)
    --  2) Nếu không có → dùng leader election + hopFindLowPlayerServer
    -- ─────────────────────────────────────────────────────────────────
    local aloneInServer   = lsAmIAloneInServer()
    local availableServers = lsFindAvailableFarmServers()

    if not aloneInServer and not targetJobId then
        -- Đang farm cùng người khác, chưa có target set → vẫn farm ở đây
        local accList2 = lsGetAccsSameServer()
        updateStatus("FARM_TYRANT",
            "✅ Đang farm cùng " .. #accList2 .. " acc khác\n"
            .. "📡 Set server hiện tại làm target...")
        lsSetFarmTarget(game.JobId, playerName)
        writeState("FARM_TYRANT", mastery, fragments, game.JobId)
        lsPost("FARM_TYRANT", game.JobId, getCurrentServerPlayers(), game.JobId)
        task.wait(2)
        startMonitoring("FARM_TYRANT")
        executeConfig("FARM_TYRANT")
        return
    end

    -- ── Bước 1.6: [NEW] Có server farm đang hoạt động còn chỗ? ──────
    --  Đọc local file → tìm server có acc đang farm + còn < 12 người
    --  Nếu có → JOIN NGAY, không cần leader election
    -- ─────────────────────────────────────────────────────────────────
    if #availableServers > 0 then
        -- Chọn server đông acc nhất còn chỗ (consolidate)
        local best = availableServers[1]

        -- ✅ FIX: Xác nhận qua API và tính cả pending count
        local apiPlayers, _ = getServerInfo(best.job_id)
        local pendingCount   = lsCountPendingAtServer(best.job_id)
        local accConfirmed, accName = lsIsAccFarmingAtServer(best.job_id)

        local canJoin = false
        local joinReason = ""

        if apiPlayers then
            -- Tính effective = api players + acc đang pending join
            local effective = apiPlayers + pendingCount
            if effective < MAX_SERVER_PLAYERS then
                canJoin = true
                joinReason = "API: " .. apiPlayers .. " + " .. pendingCount .. " pending = " .. effective .. "/" .. MAX_SERVER_PLAYERS
            end
        elseif accConfirmed then
            -- API lag, nhưng local xác nhận có acc; kiểm tra pending
            local localEff = (best.player_count or 0) + pendingCount
            if localEff < MAX_SERVER_PLAYERS then
                canJoin = true
                joinReason = accName .. " đang farm (API lag) | pending: " .. pendingCount
            end
        end

        if canJoin then
            updateStatus("FARM_TYRANT",
                "🔍 Tìm thấy server farm đang chạy!\n"
                .. "🤝 " .. best.acc_count .. " acc | " .. joinReason .. " → Join cùng farm...")
            writeState("FARM_TYRANT", mastery, fragments, best.job_id)
            -- ✅ FIX: Ghi target_job_id = best.job_id nhưng GIỮ job_id = game.JobId
            --         để acc khác biết mình đang pending, không ghi player_count sai
            lsPost("FARM_TYRANT", game.JobId, getCurrentServerPlayers(), best.job_id)
            task.wait(2)
            joinServerByJobId(best.job_id)
            return
        else
            -- Server trong local file đã full (kể cả pending) hoặc không còn hợp lệ
            updateStatus("FARM_TYRANT",
                "⚠️ Server farm cũ đã đầy (" .. (apiPlayers or "?") .. " API + "
                .. pendingCount .. " pending)/12\n🔄 Tìm server mới...")
            task.wait(1)
        end
    end

    -- ── Bước 2: Thử join target đang được set trong file ─────────────
    if targetJobId and targetJobId ~= "" then
        local curPlayers, _ = getServerInfo(targetJobId)
        local accAtTarget   = lsCountAccsAtServer(targetJobId)

        updateStatus("FARM_TYRANT",
            "🎯 Target: " .. tostring(targetJobId):sub(1,10) .. "...\n"
            .. "👥 " .. (curPlayers or "?") .. " players | 🤝 " .. accAtTarget .. " acc")
        task.wait(1)

        local accConfirmedThere, accNameThere = lsIsAccFarmingAtServer(targetJobId)

        -- ✅ FIX: Tính cả pending count khi kiểm tra slot target
        local targetPending = lsCountPendingAtServer(targetJobId)

        if curPlayers then
            local targetEff = curPlayers + targetPending
            if targetEff < MAX_SERVER_PLAYERS then
                updateStatus("FARM_TYRANT",
                    "✅ Join target (" .. curPlayers .. " + " .. targetPending .. " pending = " .. targetEff .. "/" .. MAX_SERVER_PLAYERS .. ")...")
                writeState("FARM_TYRANT", mastery, fragments, targetJobId)
                -- ✅ FIX: job_id vẫn là game.JobId (chưa join), target_job_id = targetJobId
                lsPost("FARM_TYRANT", game.JobId, getCurrentServerPlayers(), targetJobId)
                task.wait(2)
                joinServerByJobId(targetJobId)
                return
            else
                -- Kể cả pending đã full
                updateStatus("FARM_TYRANT",
                    "⚠️ Target server full kể cả pending (" .. curPlayers .. " + " .. targetPending .. " = " .. (curPlayers + targetPending) .. "/12)\n"
                    .. "🔄 Cần leader tìm server mới...")
                lsClearFarmTarget()
                task.wait(1)
            end
        elseif accConfirmedThere then
            -- API lag → kiểm tra pending trước khi join
            local localEff = targetPending  -- không có API, chỉ tính pending
            if localEff < MAX_SERVER_PLAYERS then
                updateStatus("FARM_TYRANT",
                    "✅ " .. accNameThere .. " đang farm ở target!\n"
                    .. "🚀 Join cùng farm... (" .. targetPending .. " pending, API lag)")
                writeState("FARM_TYRANT", mastery, fragments, targetJobId)
                lsPost("FARM_TYRANT", game.JobId, getCurrentServerPlayers(), targetJobId)
                task.wait(2)
                joinServerByJobId(targetJobId)
                return
            else
                updateStatus("FARM_TYRANT",
                    "⚠️ Target server có quá nhiều pending (" .. targetPending .. "/12)\n"
                    .. "🔄 Tìm server khác...")
                lsClearFarmTarget()
                task.wait(1)
            end
        else
            -- Không có API, không có acc → xóa target
            updateStatus("FARM_TYRANT",
                "⚠️ Target server không tìm thấy qua API\n"
                .. "🔄 Cần leader tìm server mới...")
            lsClearFarmTarget()
            task.wait(1)
        end
    end

    -- ── Bước 3: Không có target / không có farm server nào ──────────
    --    Leader election: acc tên nhỏ nhất alphabetically = leader
    --    Leader dùng hopFindLowPlayerServer() (method của hopsmallui.lua)
    --    để tìm server 1-3 người, set target cho cả nhóm.
    -- ─────────────────────────────────────────────────────────────────
    local amLeader, leaderName, allCandidates = lsIsLeader()

    updateStatus("FARM_TYRANT",
        "📋 " .. #allCandidates .. " acc cần hop\n"
        .. "👑 Leader: " .. leaderName
        .. (amLeader and " (Tôi)" or "")
        .. (aloneInServer and " | 🔴 Đang farm 1 mình" or ""))
    task.wait(1)

    if amLeader then
        -- ── LEADER: dùng hopFindLowPlayerServer (hopsmallui method) ──
        updateStatus("FARM_TYRANT",
            "👑 Leader → Scan server 1-3 người (hopsmallui method)...")
        task.wait(1)

        local newJobId = hopFindLowPlayerServer()

        if newJobId then
            updateStatus("FARM_TYRANT",
                "✅ Leader tìm được server ít người!\n"
                .. "🚀 Set target & Hop server → các acc khác sẽ join theo...")
            lsSetFarmTarget(newJobId, playerName)
            writeState("FARM_TYRANT", mastery, fragments, newJobId)
            -- ✅ FIX: Ghi job_id hiện tại + target_job_id = newJobId (pending)
            --         Không ghi player_count của server chưa vào
            lsPost("FARM_TYRANT", game.JobId, getCurrentServerPlayers(), newJobId)
            task.wait(2)
            joinServerByJobId(newJobId)
        else
            -- Không tìm được server 1-3 người → thử server hiện tại nếu còn chỗ
            local nowCount = getCurrentServerPlayers()
            if nowCount < MAX_SERVER_PLAYERS then
                updateStatus("FARM_TYRANT",
                    "❌ Không tìm được server ít người\n"
                    .. "⛏️ Farm server hiện tại (" .. nowCount .. "/12)...")
                lsSetFarmTarget(game.JobId, playerName)
                writeState("FARM_TYRANT", mastery, fragments, game.JobId)
                lsPost("FARM_TYRANT", game.JobId, nowCount, game.JobId)
                task.wait(3)
                startMonitoring("FARM_TYRANT")
                executeConfig("FARM_TYRANT")
            else
                updateStatus("FARM_TYRANT",
                    "⚠️ Server hiện tại đầy (" .. nowCount .. "/12)\n🔄 Rejoin ngẫu nhiên...")
                task.wait(3)
                TeleportService:Teleport(game.PlaceId, lp)
            end
        end

    else
        -- ── FOLLOWER: Chờ leader set target ─────────────────────────
        local WAIT_INTERVAL = 5
        local MAX_WAIT      = 60
        local waited        = 0

        updateStatus("FARM_TYRANT",
            "⏳ Follower → Chờ leader " .. leaderName .. " set target...\n"
            .. "(hoặc tìm server farm có sẵn trong local file)")

        while waited < MAX_WAIT do
            task.wait(WAIT_INTERVAL)
            waited = waited + WAIT_INTERVAL

            -- [NEW] Mỗi vòng lặp cũng kiểm tra local file xem có server nào sẵn không
            local freshServers = lsFindAvailableFarmServers()
            if #freshServers > 0 then
                local freshBest = freshServers[1]
                local freshAPI, _ = getServerInfo(freshBest.job_id)
                local freshPending = lsCountPendingAtServer(freshBest.job_id)
                local freshConfirmed, freshAccName = lsIsAccFarmingAtServer(freshBest.job_id)

                -- ✅ FIX: Tính effective = API + pending
                local freshEff = (freshAPI or freshBest.player_count or 0) + freshPending
                if freshEff < MAX_SERVER_PLAYERS and (freshAPI or freshConfirmed) then
                    local joinInfo = freshAPI and (freshAPI .. "+" .. freshPending .. "p = " .. freshEff .. "/" .. MAX_SERVER_PLAYERS) or "? players"
                    updateStatus("FARM_TYRANT",
                        "🔍 Follower: thấy server farm (" .. freshBest.acc_count .. " acc | " .. joinInfo .. ")\n"
                        .. "🚀 Join ngay không chờ leader...")
                    writeState("FARM_TYRANT", mastery, fragments, freshBest.job_id)
                    -- ✅ FIX: Ghi pending, không ghi player_count sai
                    lsPost("FARM_TYRANT", game.JobId, getCurrentServerPlayers(), freshBest.job_id)
                    task.wait(2)
                    joinServerByJobId(freshBest.job_id)
                    return
                end
            end

            -- Kiểm tra target do leader set
            local newTarget, newSetBy = lsGetFarmTarget()
            if newTarget and newTarget ~= "" then
                local curPlayers, _ = getServerInfo(newTarget)
                local accConfirmed, accName = lsIsAccFarmingAtServer(newTarget)

                if curPlayers and curPlayers < MAX_SERVER_PLAYERS then
                    updateStatus("FARM_TYRANT",
                        "✅ " .. (newSetBy or leaderName) .. " set target!\n"
                        .. "🚀 Join server (" .. curPlayers .. "/" .. MAX_SERVER_PLAYERS .. ")...")
                    writeState("FARM_TYRANT", mastery, fragments, newTarget)
                    lsPost("FARM_TYRANT", newTarget, curPlayers, newTarget)
                    task.wait(2)
                    joinServerByJobId(newTarget)
                    return

                elseif accConfirmed then
                    updateStatus("FARM_TYRANT",
                        "✅ " .. accName .. " đang farm ở target!\n"
                        .. "🚀 Join cùng farm... (" .. (curPlayers or "?") .. " players API)")
                    writeState("FARM_TYRANT", mastery, fragments, newTarget)
                    lsPost("FARM_TYRANT", newTarget, curPlayers or 0, newTarget)
                    task.wait(2)
                    joinServerByJobId(newTarget)
                    return

                else
                    updateStatus("FARM_TYRANT",
                        "⚠️ Target của " .. (newSetBy or leaderName) .. " đã full\n"
                        .. "🔄 Tìm target mới...")
                    lsClearFarmTarget()
                    break
                end
            end

            updateStatus("FARM_TYRANT",
                "⏳ Chờ " .. leaderName .. " hop server... ("
                .. waited .. "/" .. MAX_WAIT .. "s)")
        end

        -- ── Hết giờ chờ / target full → Sub-leader election ─────────
        updateStatus("FARM_TYRANT",
            "⚠️ Không có target khả dụng\n🔄 Sub-leader election...")
        task.wait(1)

        local lsData2       = lsRead()
        local now2          = os.time()
        local subCandidates = { playerName }
        local currentTarget = lsGetFarmTarget()

        for name, info in pairs(lsData2.players) do
            if name ~= playerName
               and info.state    == "FARM_TYRANT"
               and info.place_id == game.PlaceId
               and (now2 - (info.last_update or 0)) < LS_STALE_SECS
               and (not currentTarget or info.job_id ~= currentTarget)
            then
                table.insert(subCandidates, name)
            end
        end

        table.sort(subCandidates)
        local amSubLeader   = (subCandidates[1] == playerName)
        local subLeaderName = subCandidates[1]

        updateStatus("FARM_TYRANT",
            "📋 Sub-group: " .. #subCandidates .. " acc\n"
            .. "👑 Sub-leader: " .. subLeaderName
            .. (amSubLeader and " (Tôi)" or ""))
        task.wait(1)

        if amSubLeader then
            -- Sub-leader: dùng hopFindLowPlayerServer (hopsmallui method)
            updateStatus("FARM_TYRANT",
                "👑 Sub-leader → Scan server 1-3 người cho sub-group...")
            task.wait(1)

            local subNewJobId = hopFindLowPlayerServer()
            if subNewJobId then
                updateStatus("FARM_TYRANT",
                    "✅ Sub-leader tìm được server ít người!\n"
                    .. "🚀 Set target & Hop → các sub-follower sẽ join theo...")
                lsSetFarmTarget(subNewJobId, playerName)
                writeState("FARM_TYRANT", mastery, fragments, subNewJobId)
                -- ✅ FIX: Ghi pending, không ghi player_count sai
                lsPost("FARM_TYRANT", game.JobId, getCurrentServerPlayers(), subNewJobId)
                task.wait(2)
                joinServerByJobId(subNewJobId)
            else
                local nowCount2 = getCurrentServerPlayers()
                if nowCount2 < MAX_SERVER_PLAYERS then
                    updateStatus("FARM_TYRANT",
                        "❌ Không tìm được server mới\n"
                        .. "⛏️ Farm server hiện tại (" .. nowCount2 .. "/12)...")
                    lsSetFarmTarget(game.JobId, playerName)
                    writeState("FARM_TYRANT", mastery, fragments, game.JobId)
                    lsPost("FARM_TYRANT", game.JobId, nowCount2, game.JobId)
                    task.wait(3)
                    startMonitoring("FARM_TYRANT")
                    executeConfig("FARM_TYRANT")
                else
                    updateStatus("FARM_TYRANT",
                        "⚠️ Server hiện tại đầy (" .. nowCount2 .. "/12)\n🔄 Rejoin ngẫu nhiên...")
                    task.wait(3)
                    TeleportService:Teleport(game.PlaceId, lp)
                end
            end

        else
            -- Sub-follower: chờ sub-leader
            local subWaited = 0
            local SUB_MAX   = 45

            updateStatus("FARM_TYRANT",
                "⏳ Sub-follower → Chờ sub-leader " .. subLeaderName .. "...")

            while subWaited < SUB_MAX do
                task.wait(WAIT_INTERVAL)
                subWaited = subWaited + WAIT_INTERVAL

                -- [NEW] Sub-follower cũng kiểm tra local file
                local subFreshServers = lsFindAvailableFarmServers()
                if #subFreshServers > 0 then
                    local sf = subFreshServers[1]
                    local sfAPI, _ = getServerInfo(sf.job_id)
                    local sfPending = lsCountPendingAtServer(sf.job_id)
                    local sfConfirmed, sfAccName = lsIsAccFarmingAtServer(sf.job_id)
                    local sfEff = (sfAPI or sf.player_count or 0) + sfPending
                    if sfEff < MAX_SERVER_PLAYERS and (sfAPI or sfConfirmed) then
                        updateStatus("FARM_TYRANT",
                            "🔍 Sub-follower: thấy server farm (" .. sf.acc_count .. " acc | eff: " .. sfEff .. "/12)\n"
                            .. "🚀 Join ngay không chờ sub-leader...")
                        writeState("FARM_TYRANT", mastery, fragments, sf.job_id)
                        -- ✅ FIX: Ghi pending, không ghi player_count sai
                        lsPost("FARM_TYRANT", game.JobId, getCurrentServerPlayers(), sf.job_id)
                        task.wait(2)
                        joinServerByJobId(sf.job_id)
                        return
                    end
                end

                local newTarget2, newSetBy2 = lsGetFarmTarget()
                if newTarget2 and newTarget2 ~= "" then
                    local curPlayers2, _ = getServerInfo(newTarget2)
                    local accConfirmed2, accName2 = lsIsAccFarmingAtServer(newTarget2)
                    if curPlayers2 and curPlayers2 < MAX_SERVER_PLAYERS then
                        updateStatus("FARM_TYRANT",
                            "✅ Sub-leader " .. (newSetBy2 or subLeaderName) .. " set target!\n"
                            .. "🚀 Join server (" .. curPlayers2 .. "/" .. MAX_SERVER_PLAYERS .. ")...")
                        writeState("FARM_TYRANT", mastery, fragments, newTarget2)
                        lsPost("FARM_TYRANT", newTarget2, curPlayers2, newTarget2)
                        task.wait(2)
                        joinServerByJobId(newTarget2)
                        return
                    elseif accConfirmed2 then
                        updateStatus("FARM_TYRANT",
                            "✅ " .. accName2 .. " đang farm ở target!\n"
                            .. "🚀 Join cùng farm... (" .. (curPlayers2 or "?") .. " players API)")
                        writeState("FARM_TYRANT", mastery, fragments, newTarget2)
                        lsPost("FARM_TYRANT", newTarget2, curPlayers2 or 0, newTarget2)
                        task.wait(2)
                        joinServerByJobId(newTarget2)
                        return
                    end
                end

                updateStatus("FARM_TYRANT",
                    "⏳ Chờ sub-leader " .. subLeaderName .. "... ("
                    .. subWaited .. "/" .. SUB_MAX .. "s)")
            end

            -- Hết hạn → farm server hiện tại
            updateStatus("FARM_TYRANT",
                "❌ Hết thời gian chờ sub-leader\n⛏️ Farm server hiện tại...")
            writeState("FARM_TYRANT", mastery, fragments, game.JobId)
            lsPost("FARM_TYRANT", game.JobId, getCurrentServerPlayers(), game.JobId)
            task.wait(3)
            startMonitoring("FARM_TYRANT")
            executeConfig("FARM_TYRANT")
        end
    end
end

-- ============================================================
--  MASTERY WATCHER  (event-based)
-- ============================================================
local masteryWatcherActive = false

local function findTalonLevel()
    local locations = {
        workspace.Characters and workspace.Characters:FindFirstChild(playerName),
        lp.Character,
        lp.Backpack,
    }
    for _, container in ipairs(locations) do
        if container then
            local tool = container:FindFirstChild("Dragon Talon")
            if tool then
                local lv = tool:FindFirstChild("Level")
                if lv then return lv, tool end
            end
        end
    end
    return nil, nil
end

local function hookTalonLevel(onMasteryChange)
    local lv, _ = findTalonLevel()
    if not lv then return nil end
    onMasteryChange(lv.Value)
    return lv.Changed:Connect(function(newVal)
        onMasteryChange(newVal)
    end)
end

function startMasteryWatcher(targetMastery, onReached)
    if masteryWatcherActive then return end
    masteryWatcherActive = true

    local triggered = false

    local function handleMastery(mas)
        if triggered then return end
        local frags = checkFragments()
        updateStatus("FARM_MASTERY",
            "⚔️ Mastery: " .. mas .. "/" .. targetMastery
            .. " | 💎 Frags: " .. frags)
        if mas >= targetMastery then
            triggered = true
            masteryWatcherActive = false
            onReached(mas)
        end
    end

    task.spawn(function()
        task.wait(5)

        local currentConn = nil

        local function reconnect()
            if currentConn then
                pcall(function() currentConn:Disconnect() end)
                currentConn = nil
            end
            if triggered then return end
            currentConn = hookTalonLevel(handleMastery)
        end

        reconnect()

        local bpConn = lp.Backpack.ChildAdded:Connect(function(child)
            if child.Name == "Dragon Talon" then
                task.wait(0.1)
                reconnect()
            end
        end)

        local function watchChar(char)
            if not char then return end
            char.ChildAdded:Connect(function(child)
                if child.Name == "Dragon Talon" then
                    task.wait(0.1)
                    reconnect()
                end
            end)
        end

        local wsChars = workspace:FindFirstChild("Characters")
        if wsChars then
            local myChar = wsChars:FindFirstChild(playerName)
            if myChar then watchChar(myChar) end
            wsChars.ChildAdded:Connect(function(child)
                if child.Name == playerName then
                    task.wait(1)
                    watchChar(child)
                    reconnect()
                end
            end)
        end

        lp.CharacterAdded:Connect(function(char)
            task.wait(1)
            watchChar(char)
            reconnect()
        end)

        while masteryWatcherActive do
            task.wait(10)
            pcall(function()
                if triggered then return end
                local lv, _ = findTalonLevel()
                if lv then
                    handleMastery(lv.Value)
                    if not currentConn then reconnect() end
                end
            end)
        end

        pcall(function() if currentConn then currentConn:Disconnect() end end)
        pcall(function() bpConn:Disconnect() end)
    end)
end

-- ============================================================
--  MONITORING LOOP
-- ============================================================
local monitorActive = false

function startMonitoring(initStateType)
    if monitorActive then return end
    monitorActive = true

    startLocalServerHeartbeat(function()
        local s = readState()
        return s.state or initStateType
    end)

    if initStateType == "FARM_MASTERY" then
        startMasteryWatcher(500, function(mas)
            local frags = checkFragments()
            updateStatus("FARM_MASTERY", "✅ Đủ 500 Mastery! → Kiểm tra Fragments...")
            task.wait(2)
            monitorActive = false

            if frags >= 25000 then
                writeState("FARM_DOJOBELT", mas, frags)
                lsPost("FARM_DOJOBELT")
                local rndId, _ = findRandomServer()
                if rndId then
                    updateStatus("FARM_DOJOBELT",
                        "✅ Đủ cả Mastery + Fragments!\n🚀 Hop server → Farm Dojo Belt...")
                    task.wait(1)
                    joinServerByJobId(rndId)
                else
                    TeleportService:Teleport(game.PlaceId, lp)
                end
            else
                writeState("FARM_TYRANT", mas, frags)
                task.wait(2)
                lsPost("FARM_TYRANT")
                handleFarmTyrant(mas, frags)
            end
        end)
        return
    end

    -- Poll fragments mỗi 30s cho FARM_TYRANT / FARM_DOJOBELT
    task.spawn(function()
        task.wait(15)

        while monitorActive do
            pcall(function()
                local saved = readState()
                local state = saved.state or initStateType
                local frags = checkFragments()

                lsPost(state, game.JobId, getCurrentServerPlayers(), game.JobId)

                if state == "FARM_TYRANT" then
                    -- ✅ FIX: chỉ đếm acc đang ở CÙNG server với mình
                    local accList = lsGetAccsSameServer()
                    local srvCount = getCurrentServerPlayers()
                    updateStatus("FARM_TYRANT",
                        "💎 Frags: " .. frags .. "/25000"
                        .. " | 👥 " .. srvCount .. "/12"
                        .. " | 🤝 " .. #accList .. " acc cùng server")

                    if frags >= 25000 then
                        monitorActive = false
                        writeState("FARM_DOJOBELT", 500, frags)
                        lsPost("FARM_DOJOBELT")
                        updateStatus("FARM_TYRANT", "✅ Đủ 25000 Fragments! → Farm Dojo Belt...")
                        task.wait(2)
                        local rndId, _ = findRandomServer()
                        if rndId then joinServerByJobId(rndId)
                        else TeleportService:Teleport(game.PlaceId, lp) end
                        return
                    end

                elseif state == "FARM_DOJOBELT" then
                    updateStatus("FARM_DOJOBELT",
                        "⚔️ Farm Dojo Belt | 💎 Frags: " .. frags)
                end
            end)

            task.wait(30)
        end
    end)
end

