-- ============================================================
--  [FIX] Tìm các server farm đang hoạt động CÒN CHỖ TRỐNG
--
--  Đọc local file, gom nhóm acc theo job_id thực tế,
--  tính effective_count = player_count + pending_count,
--  lọc server có effective_count < MAX_SERVER_PLAYERS.
--  Trả về list {job_id, acc_count, player_count, pending_count}
--  sắp xếp theo acc_count giảm dần.
-- ============================================================
function lsFindAvailableFarmServers()
    local data    = lsRead()
    local now     = os.time()
    local servers = {}   -- map job_id → {job_id, acc_count, player_count, pending_count}

    -- Gom acc đã THỰC SỰ ở server (job_id)
    for name, info in pairs(data.players) do
        if name ~= playerName
           and info.state    == "FARM_TYRANT"
           and info.place_id == game.PlaceId
           and type(info.job_id) == "string"
           and info.job_id ~= ""
           and info.job_id ~= game.JobId
           and (now - (info.last_update or 0)) < LS_STALE_SECS
        then
            local jid = info.job_id
            if not servers[jid] then
                servers[jid] = {
                    job_id        = jid,
                    acc_count     = 0,
                    player_count  = info.player_count or 0,
                    pending_count = 0,
                }
            end
            servers[jid].acc_count = servers[jid].acc_count + 1
            if (info.player_count or 0) > servers[jid].player_count then
                servers[jid].player_count = info.player_count
            end
        end
    end

    -- Đếm thêm pending (target_job_id trỏ vào server đó nhưng chưa đến)
    for name, info in pairs(data.players) do
        if name ~= playerName
           and info.state    == "FARM_TYRANT"
           and info.place_id == game.PlaceId
           and (now - (info.last_update or 0)) < LS_STALE_SECS
           and type(info.target_job_id) == "string"
           and info.target_job_id ~= ""
           and info.target_job_id ~= game.JobId
           and info.target_job_id ~= info.job_id   -- đang pending, chưa tới
        then
            local tjid = info.target_job_id
            if servers[tjid] then
                servers[tjid].pending_count = servers[tjid].pending_count + 1
            end
        end
    end

    -- Chỉ giữ server có effective_count (player + pending) < MAX_SERVER_PLAYERS
    local available = {}
    for _, sv in pairs(servers) do
        local effective = sv.player_count + sv.pending_count
        if effective < MAX_SERVER_PLAYERS then
            table.insert(available, sv)
        end
    end

    -- Sắp xếp: server nhiều acc nhất lên trước (consolidate)
    table.sort(available, function(a, b)
        return a.acc_count > b.acc_count
    end)

    return available
end

-- ============================================================
--  [NEW] Tìm server ÍT NGƯỜI theo phương pháp hopsmallui.lua
--  (scan Roblox API, tìm server 1-3 người, lấy ứng viên thứ 10)
--  Trả về jobId hoặc nil nếu không tìm được
-- ============================================================
function hopFindLowPlayerServer()
    local cursor     = ""
    local candidates = {}
    local attempts   = 0
    local maxAttempts = 5

    repeat
        attempts = attempts + 1
        local ok, result = pcall(function()
            return HttpService:JSONDecode(
                game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId
                             .. "/servers/Public?sortOrder=Asc&limit=100&cursor=" .. cursor)
            )
        end)

        if ok and result and type(result) == "table"
           and result.data and type(result.data) == "table"
        then
            for _, sv in pairs(result.data) do
                if type(sv) == "table" and sv.playing and sv.id
                   and sv.playing >= 1 and sv.playing <= 3
                   and sv.id ~= game.JobId
                then
                    table.insert(candidates, sv)
                    updateStatus("FARM_TYRANT",
                        "🔍 Scan server ít người... "
                        .. #candidates .. "/10 ứng viên")

                    if #candidates >= 10 then
                        -- Trả về ứng viên thứ 10 (phương pháp hopsmallui)
                        return candidates[10].id
                    end
                end
            end
            cursor = result.nextPageCursor or ""
        else
            task.wait(2)
        end
    until cursor == "" or attempts >= maxAttempts

    -- Nếu tìm được ít hơn 10, lấy cái cuối cùng
    if #candidates > 0 then
        return candidates[#candidates].id
    end
    return nil
end

