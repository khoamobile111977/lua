local LS_STALE_SECS    = 300
local LS_TARGET_STALE  = 600
local MAX_SERVER_PLAYERS = 12

function lsRead()
    if isfile(localServerFile) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(localServerFile)) end)
        if ok and data and type(data.players) == "table" then return data end
    end
    return { players = {} }
end

function lsWrite(data)
    pcall(function() writefile(localServerFile, HttpService:JSONEncode(data)) end)
end

function lsPost(state, jobId, playerCount, targetJobId)
    local data = lsRead()
    data.players[playerName] = {
        state          = state,
        place_id       = game.PlaceId,
        job_id         = jobId or game.JobId,
        target_job_id  = targetJobId or (jobId or game.JobId),
        player_count   = playerCount or getCurrentServerPlayers(),
        last_update    = os.time(),
    }
    lsWrite(data)
end

function lsUnregister()
    local data = lsRead()
    data.players[playerName] = nil
    lsWrite(data)
end

function lsGetFarmTarget()
    local data    = lsRead()
    local target  = data.farm_tyrant_target
    local updated = data.target_updated or 0
    local setBy   = data.target_set_by or ""
    if target and target ~= "" and (os.time() - updated) < LS_TARGET_STALE then
        return target, setBy
    end
    return nil, nil
end

function lsSetFarmTarget(jobId, setBy)
