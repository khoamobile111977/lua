-- ============================================================
local function teleportToServer(jobId)
    if not jobId or jobId == "" then return false end
    if not ServerBrowser then
        warn("[DRACO0] ❌ __ServerBrowser nil, không thể teleport!")
        return false
    end
    local success, err = pcall(function()
        ServerBrowser:InvokeServer("teleport", jobId)
    end)
    if success then
        print("[DRACO0] ✅ ServerBrowser teleport OK → " .. tostring(jobId):sub(1,12))
        return true
    end
    warn("[DRACO0] ❌ ServerBrowser teleport thất bại: " .. tostring(err))
    return false
end

-- Rejoin ngẫu nhiên: lấy job_id từ API rồi dùng ServerBrowser
local function rejoinRandom()
    updateStatus("FARM_TYRANT", "🔄 Tìm server ngẫu nhiên để rejoin...")
    local attempts = 0
    while attempts < 5 do
        attempts = attempts + 1
        local rndId, _ = findRandomServer()
        if rndId then
            updateStatus("FARM_TYRANT", "🚀 Rejoin → " .. tostring(rndId):sub(1,12) .. "...")
            local ok = teleportToServer(rndId)
            if ok then return end
        end
        updateStatus("FARM_TYRANT", "⏳ Chờ rồi thử lại rejoin... (" .. attempts .. "/5)")
        task.wait(5)
    end
    warn("[DRACO0] ❌ Không thể rejoin sau 5 lần thử!")
end

-- ============================================================
--  TELEPORT FAILURE HANDLER
-- ============================================================
local _teleportFailCallback = nil
local _lastPendingJobId     = nil

TeleportService.TeleportInitFailed:Connect(function(player, result, errorMessage)
    if player ~= lp then return end

    local reason = tostring(result)
    warn("[DRACO0] ❌ TeleportInitFailed: " .. reason
         .. " | job: " .. tostring(_lastPendingJobId or "?"):sub(1,12)
         .. " | " .. tostring(errorMessage))

    pcall(function()
        lsPost("FARM_TYRANT", game.JobId, getCurrentServerPlayers(), game.JobId)
    end)
    pcall(function()
        local t, _ = lsGetFarmTarget()
        if t and t == _lastPendingJobId then lsClearFarmTarget() end
    end)

    _lastPendingJobId = nil

    local delay = 5
    local msg   = "❌ Server từ chối join (" .. reason .. ")!\n🔄 Xử lý lại..."
    if result == Enum.TeleportResult.Flooded then
        delay = 15
        msg = "⏳ Rate-limited! Chờ " .. delay .. "s rồi thử lại..."
    elseif result == Enum.TeleportResult.GameFull then
        msg = "⚠️ Server đầy! Tìm server khác..."
        delay = 3
    end

    updateStatus("FARM_TYRANT", msg)
    task.wait(delay)

    local cb = _teleportFailCallback
    _teleportFailCallback = nil

    if cb then
        pcall(cb)
    else
        local saved = readState()
        if saved.state == "FARM_TYRANT" then
            pcall(function() handleFarmTyrant(saved.mastery or 0, saved.fragments or 0) end)
        else
            rejoinRandom()
        end
    end
end)

function joinServerByJobId(jobId, onFailCallback)
    if not jobId or jobId == "" then return end

    _lastPendingJobId     = jobId
    _teleportFailCallback = onFailCallback or function()
        local saved = readState()
        if saved.state == "FARM_TYRANT" then
            handleFarmTyrant(saved.mastery or 0, saved.fragments or 0)
        else
            rejoinRandom()
        end
    end

    updateStatus("FARM_TYRANT", "🚀 Đang teleport tới server...")
    local ok = teleportToServer(jobId)
    if not ok then
        _lastPendingJobId     = nil
        _teleportFailCallback = nil
        updateStatus("FARM_TYRANT", "❌ Teleport thất bại ngay → Rejoin ngẫu nhiên...")
        task.wait(3)
        rejoinRandom()
    end
end

-- ============================================================
--  MUA DRAGON TALON
-- ============================================================
function buyDragonTalon()
    task.wait(5)

    local function findNPC(npcName)
        for _, container in ipairs({ workspace:FindFirstChild("NPCs"), game.ReplicatedStorage:FindFirstChild("NPCs") }) do
            if container then
                for _, npc in ipairs(container:GetChildren()) do
                    if npc.Name == npcName and npc:FindFirstChild("HumanoidRootPart") then
                        return npc
                    end
                end
            end
        end
        return nil
    end

    local function calcpos(a, b)
        if not a then return math.huge end
        b = b or (lp.Character and lp.Character.PrimaryPart and lp.Character.PrimaryPart.CFrame) or CFrame.new(0,0,0)
        return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
    end

    local function TP1(Pos)
        local char = lp.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end
        local DistanceToPos = calcpos(hrp.CFrame, Pos)
        if DistanceToPos <= 100 then
            wait(0.1); hrp.CFrame = Pos; return true
        end
        local Speed  = 250
        local twTime = math.max(0.3, DistanceToPos / Speed)
        local tween  = TweenService:Create(hrp, TweenInfo.new(twTime, Enum.EasingStyle.Linear), { CFrame = Pos })
        tween:Play()
        hrp.CFrame = CFrame.new(hrp.Position.X, Pos.Y, hrp.Position.Z)
        return true
    end

    local function tpToNPC(npcName)
        local npc = findNPC(npcName)
        if npc and npc:FindFirstChild("HumanoidRootPart") then
            local targetPos = CFrame.new(npc.HumanoidRootPart.Position)
            while true do
                local char = lp.Character or lp.CharacterAdded:Wait()
                local hrp  = char:WaitForChild("HumanoidRootPart")
                local hum  = char:WaitForChild("Humanoid")
                if hum.Health <= 0 then
                    char = lp.CharacterAdded:Wait()
                    hrp  = char:WaitForChild("HumanoidRootPart")
                    hum  = char:WaitForChild("Humanoid")
                    task.wait(1)
                end
                TP1(targetPos)
                local reached  = false
                local stuckTime = 0
                local lastPos  = hrp.Position
                while task.wait(0.1) do
                    if not char or not char.Parent or hum.Health <= 0 or not hrp or not hrp.Parent then break end
                    if (hrp.Position - npc.HumanoidRootPart.Position).Magnitude <= 10 then reached = true; break end
                    if (hrp.Position - lastPos).Magnitude < 1 then
                        stuckTime = stuckTime + 0.1
                        if stuckTime >= 3 then break end
                    else
                        stuckTime = 0
                    end
                    lastPos = hrp.Position
                end
                if reached then return true end
                task.wait(0.5)
            end
        end
        return false
    end

    if tpToNPC("Uzoth") then
        task.wait(2)
        pcall(function()
            game.ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyDragonTalon")
        end)
        task.wait(3)
    end
end

local function hasDragonTalon()
    local inBp  = lp.Backpack:FindFirstChild("Dragon Talon")
    local cNode = workspace.Characters and workspace.Characters:FindFirstChild(playerName) or lp.Character
    local inCh  = cNode and cNode:FindFirstChild("Dragon Talon")
    return (inBp ~= nil) or (inCh ~= nil)
end

local function buyDragonTalonWithRetry()
    local MAX_BUY_RETRY = 5
    for attempt = 1, MAX_BUY_RETRY do
        updateStatus("CHECK_TALON", "🛒 Mua Dragon Talon... (lần " .. attempt .. "/" .. MAX_BUY_RETRY .. ")")
        buyDragonTalon()
        task.wait(4)
        if hasDragonTalon() then
            updateStatus("CHECK_TALON", "✅ Đã mua xong Dragon Talon!")
            task.wait(1)
            return true
        end
        if attempt < MAX_BUY_RETRY then
            updateStatus("CHECK_TALON", "⚠️ Chưa thấy Dragon Talon → Mua lại... (" .. attempt .. "/" .. MAX_BUY_RETRY .. ")")
            task.wait(2)
        end
    end
    updateStatus("CHECK_TALON", "❌ Không mua được Dragon Talon sau " .. MAX_BUY_RETRY .. " lần!")
    return false
end

