end

-- ============================================================
--  LOCAL SERVER: LEADER ELECTION
--
--  Leader = acc có tên alphabetically nhỏ nhất
--  trong số các acc FARM_TYRANT còn active.
--  Leader có quyền set farm_tyrant_target.
-- ============================================================
function lsIsLeader()
    local data       = lsRead()
    local now        = os.time()
    local candidates = { playerName }   -- luôn bao gồm mình

    for name, info in pairs(data.players) do
        if name ~= playerName
           and info.state    == "FARM_TYRANT"
           and info.place_id == game.PlaceId
           and (now - (info.last_update or 0)) < LS_STALE_SECS
        then
            table.insert(candidates, name)
        end
    end

    table.sort(candidates)
    local isLeader  = (candidates[1] == playerName)
    local leaderName = candidates[1]
    return isLeader, leaderName, candidates
end

