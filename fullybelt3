-- ============================================================
local function findServerBrowser()
    -- Tìm trong các vị trí phổ biến của Blox Fruits
    local locations = {
        rs.Remotes,
        rs,
        game.Players.LocalPlayer.PlayerGui,
    }
    for _, container in ipairs(locations) do
        if container then
            for _, child in ipairs(container:GetChildren()) do
                local n = child.Name:lower()
                if (n:find("serverbrowser") or n:find("server_browser") or n:find("hopping"))
                   and child:IsA("RemoteFunction")
                then
                    return child
                end
            end
        end
    end
    -- Fallback: tìm bất kỳ RemoteFunction nào có "server" trong tên
    for _, child in ipairs(rs.Remotes:GetChildren()) do
        if child.Name:lower():find("server") and child:IsA("RemoteFunction") then
            return child
        end
    end
    return nil
end

local function teleportToServer(jobId)
    if not jobId or jobId == "" then return false end

    -- Thử ServerBrowser trước
    local ServerBrowser = findServerBrowser()
    if ServerBrowser then
        local success, err = pcall(function()
            ServerBrowser:InvokeServer("teleport", jobId)
        end)
        if success then
            print("[DRACO0] ✅ ServerBrowser teleport OK → " .. tostring(jobId):sub(1,12))
            return true
        end
        warn("[DRACO0] ServerBrowser thất bại:", err)
    end

    -- Fallback: TeleportToPlaceInstance
    local ok = pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, lp)
    end)
    if ok then
        print("[DRACO0] ✅ TeleportToPlaceInstance OK → " .. tostring(jobId):sub(1,12))
        return true
    end

    return false
end

-- ============================================================
--  TELEPORT FAILURE HANDLER  (Global)
--
--  Lắng nghe TeleportService.TeleportInitFailed để xử lý khi
--  Roblox từ chối join (GameFull, Flooded, v.v.)
--  Thay vì script đứng im, tự động reset pending và farm lại.
-- ============================================================
local _teleportFailCallback = nil   -- callback gọi khi teleport fail
local _lastPendingJobId     = nil   -- job_id đang cố join

TeleportService.TeleportInitFailed:Connect(function(player, result, errorMessage)
    if player ~= lp then return end

    local reason = tostring(result)
    warn("[DRACO0] ❌ TeleportInitFailed: " .. reason
         .. " | job: " .. tostring(_lastPendingJobId or "?"):sub(1,12)
         .. " | " .. tostring(errorMessage))

    -- Reset pending: trả job_id về server thật, xóa target_job_id pending
    pcall(function()
        lsPost("FARM_TYRANT", game.JobId, getCurrentServerPlayers(), game.JobId)
    end)

    -- Nếu target chung trong file chính là server vừa bị từ chối → xóa
    pcall(function()
        local t, _ = lsGetFarmTarget()
        if t and t == _lastPendingJobId then
            lsClearFarmTarget()
        end
    end)

    _lastPendingJobId = nil

    -- Chọn delay tuỳ theo lý do từ chối
    local delay = 5
    local msg   = "❌ Server từ chối join (" .. reason .. ")!\n🔄 Xử lý lại..."
    if result == Enum.TeleportResult.Flooded then
        delay = 15
        msg = "⏳ Rate-limited! Chờ " .. delay .. "s rồi thử lại..."
    elseif result == Enum.TeleportResult.GameFull then
        msg = "⚠️ Server đầy! Tìm server khác..."
        delay = 3
    end

    updateStatus("FARM_TYRANT", msg)
    task.wait(delay)

    -- Gọi callback nếu có (được set bởi joinServerByJobId)
    local cb = _teleportFailCallback
    _teleportFailCallback = nil

    if cb then
        pcall(cb)
    else
        -- Fallback: đọc state từ file và re-run farm
        local saved = readState()
        if saved.state == "FARM_TYRANT" then
            pcall(function()
                handleFarmTyrant(saved.mastery or 0, saved.fragments or 0)
            end)
        else
            TeleportService:Teleport(game.PlaceId, lp)
        end
    end
end)

function joinServerByJobId(jobId, onFailCallback)
    if not jobId or jobId == "" then return end

    -- Lưu lại để TeleportInitFailed biết server nào bị từ chối
    _lastPendingJobId   = jobId
    _teleportFailCallback = onFailCallback or function()
        -- Mặc định: đọc state file và farm lại từ đầu
        local saved = readState()
        if saved.state == "FARM_TYRANT" then
            handleFarmTyrant(saved.mastery or 0, saved.fragments or 0)
        else
            TeleportService:Teleport(game.PlaceId, lp)
        end
    end

    updateStatus("FARM_TYRANT", "🚀 Đang teleport tới server...")
    local ok = teleportToServer(jobId)
    if not ok then
        -- Teleport bị block ngay lập tức (không phải async fail)
        _lastPendingJobId     = nil
        _teleportFailCallback = nil
        updateStatus("FARM_TYRANT", "❌ Teleport thất bại ngay → Rejoin toàn bộ...")
        wait(3)
        TeleportService:Teleport(game.PlaceId, lp)
    end
    -- Nếu ok: script chờ Roblox teleport hoặc TeleportInitFailed fire
end

