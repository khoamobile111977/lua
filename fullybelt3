local LS_STALE_SECS    = 300   -- Coi acc là offline nếu không update > 5 phút
local LS_TARGET_STALE  = 600   -- Target hết hạn sau 10 phút không update
local MAX_SERVER_PLAYERS = 12  -- Tối đa player trong 1 server (server giới hạn 12 người)

function lsRead()
    if isfile(localServerFile) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(localServerFile)) end)
        if ok and data and type(data.players) == "table" then return data end
    end
    return { players = {} }
end

function lsWrite(data)
    pcall(function() writefile(localServerFile, HttpService:JSONEncode(data)) end)
end

-- Post thông tin acc hiện tại lên local server
function lsPost(state, jobId, playerCount, targetJobId)
    local data = lsRead()
    data.players[playerName] = {
        state          = state,
        place_id       = game.PlaceId,
        job_id         = jobId or game.JobId,
        target_job_id  = targetJobId or (jobId or game.JobId),
        player_count   = playerCount or getCurrentServerPlayers(),
        last_update    = os.time(),
    }
    lsWrite(data)
end

