-- Lấy target server hiện tại cho FARM_TYRANT
-- Trả về: targetJobId, setBy  hoặc  nil, nil
function lsGetFarmTarget()
    local data      = lsRead()
    local target    = data.farm_tyrant_target
    local updated   = data.target_updated or 0
    local setBy     = data.target_set_by or ""

    if target and target ~= ""
       and (os.time() - updated) < LS_TARGET_STALE
    then
        return target, setBy
    end
    return nil, nil
end

