            if not stateData then break end
            
            local state = stateData.state
            
            if state == "FARM_DOJOTRAINER" then
                if checkInventory("Dojo Belt (Red)") then
                    writeState("FARM_VOLCANO_DINOBONE")
                    task.wait(2)
                    game:GetService("TeleportService"):Teleport(game.PlaceId, lp)
                    break
