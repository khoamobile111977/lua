-- Function bật NoClip
local function enableDracoNoClip()
    if DracoNoClipConnection then return end
    DracoNoClipConnection = game:GetService("RunService").Stepped:Connect(function()
        pcall(function()
            if not getgenv().DracoNoClip then return end
            local char = lp.Character
            if not (char and char:FindFirstChild("Head") and char:FindFirstChild("HumanoidRootPart")) then return end
            
            -- Tạo BodyVelocity nếu chưa có
            if not char.Head:FindFirstChild("DracoBodyClip") then
                local bv = Instance.new("BodyVelocity")
                bv.Name = "DracoBodyClip"
                bv.Velocity = Vector3.new(0, 0, 0)
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.P = 15000
                bv.Parent = char.Head
            end
            
            -- Tắt collision cho tất cả parts
            for _, v in ipairs(char:GetDescendants()) do
                if v:IsA("BasePart") then 
                    v.CanCollide = false 
                end
            end
        end)
    end)
end

-- Function tắt NoClip
local function disableDracoNoClip()
    pcall(function()
        if DracoNoClipConnection then
            DracoNoClipConnection:Disconnect()
            DracoNoClipConnection = nil
        end
        
        local char = lp.Character
        if char and char:FindFirstChild("Head") then
            local clip = char.Head:FindFirstChild("DracoBodyClip")
            if clip then clip:Destroy() end
            
            -- Bật lại collision (trừ HumanoidRootPart)
            for _, v in ipairs(char:GetDescendants()) do
                if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                    v.CanCollide = true
                end
            end
        end
    end)
end

-- Hàm tính khoảng cách 2D (bỏ qua trục Y)
local function calcDistance2D(pos1, pos2)
    if not pos1 or not pos2 then return math.huge end
    local p1 = typeof(pos1) == "CFrame" and pos1.Position or pos1
    local p2 = typeof(pos2) == "CFrame" and pos2.Position or pos2
    return (Vector3.new(p1.X, 0, p1.Z) - Vector3.new(p2.X, 0, p2.Z)).Magnitude
end

-- ===== TP1 - MAIN FUNCTION =====
function TP1(targetPos)
    local char = lp.Character
    if not char then return false end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if not hrp or not hum or hum.Health <= 0 then return false end
    
    -- Chuyển đổi sang CFrame nếu cần
    local targetCFrame = typeof(targetPos) == "CFrame" and targetPos or CFrame.new(targetPos)
    
    -- Kích hoạt NoClip
    getgenv().DracoNoClip = true
    enableDracoNoClip()
    
    -- Tính khoảng cách
    local distance = calcDistance2D(hrp.CFrame, targetCFrame)
    
    -- Nếu đủ gần, teleport trực tiếp
    if distance <= 100 then
        if Main.CurrentTween then
            Main.CurrentTween:Cancel()
            Main.CurrentTween = nil
        end
        Main.IsMoving = false
        
        task.wait(0.1)
        hrp.CFrame = targetCFrame
        task.wait(0.1)
        
        getgenv().DracoNoClip = false
        disableDracoNoClip()
        return true
    end
    
    local tweenSpeed = 300
    local tweenTime = math.max(0.3, distance / tweenSpeed)
    
    if Main.CurrentTween then
        Main.CurrentTween:Cancel()
    end
    
    Main.IsMoving = true
    
    local tweenInfo = TweenInfo.new(
        tweenTime,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )
    
    Main.CurrentTween = ts:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    Main.CurrentTween.Completed:Connect(function(playbackState)
        Main.IsMoving = false
        Main.CurrentTween = nil
        getgenv().DracoNoClip = false
        disableDracoNoClip()
    end)
    
    hrp.CFrame = CFrame.new(hrp.Position.X, targetCFrame.Position.Y, hrp.Position.Z)
    
    Main.CurrentTween:Play()
    
    return true
end

function StopTween()
    if Main.CurrentTween then
        Main.CurrentTween:Cancel()
        Main.CurrentTween = nil
    end
    Main.IsMoving = false
    getgenv().DracoNoClip = false
    disableDracoNoClip()
end


function findNPC(npcName)
    for _, container in ipairs({workspace:FindFirstChild("NPCs"), rs:FindFirstChild("NPCs")}) do
        if container then
            for _, npc in ipairs(container:GetChildren()) do
                if npc.Name == npcName and npc:FindFirstChild("HumanoidRootPart") then
                    return npc
                end
            end
        end
    end
    return nil
end

function tpToNPC(npcName)
    local npc = findNPC(npcName)
    if npc and npc:FindFirstChild("HumanoidRootPart") then
        TP1(CFrame.new(npc.HumanoidRootPart.Position))
        local char = lp.Character or lp.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart")
        repeat task.wait() until (hrp.Position - npc.HumanoidRootPart.Position).Magnitude <= 5
        return true
    end
    return false
end

