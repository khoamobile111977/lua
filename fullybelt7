-- ============================================================
--  FIX MEMORY LEAK: thay _pulseConn (không có tác dụng) bằng
--  _pulseActive (flag dừng loop) + _pulseThread (để task.cancel).
--
--  Vấn đề cũ:
--    - Mỗi lần updateStatus() được gọi → spawn 1 "while true do" mới
--    - _pulseConn chỉ gán nil chứ không disconnect/cancel gì
--    - Loop cũ vẫn chạy ngầm → càng gọi nhiều càng nhiều zombie loop
--    - Tween đang chạy dở cũng không bị cancel → lãng phí CPU
--
--  Fix:
--    1. _pulseActive = false  → báo loop cũ tự dừng sau wait tiếp theo
--    2. task.cancel(_pulseThread) → kill thread ngay lập tức, không chờ
--    3. Cancel tween A/B đang chạy dở trước khi thoát loop
--    4. Luôn kiểm tra _pulseActive sau mỗi task.wait() trong loop mới
-- ============================================================
local _pulseActive = false
local _pulseThread = nil

local function updateStatus(state, extraText)
    pcall(function()
        local color = stateColors[state] or Color3.fromRGB(139, 92, 246)
        local label = stateLabels[state] or tostring(state)
        local img   = stateImages[state] or ""

        StateLabel.Text = label
        ExtraLabel.Text = extraText and extraText:gsub("^%s+", "") or ""
        ItemImage.Image = img
        ImgStroke.Color = color

        BorderStroke.Color         = color
        BorderStroke.Transparency  = 0.3
        AccentBar.BackgroundColor3 = color

        -- Dừng loop pulse cũ trước khi spawn loop mới
        _pulseActive = false
        if _pulseThread then
            pcall(function() task.cancel(_pulseThread) end)
            _pulseThread = nil
        end

        -- Reset bar về trạng thái rõ ràng trước khi bắt đầu pulse mới
        AccentBar.BackgroundTransparency = 0

        _pulseActive = true
        _pulseThread = task.spawn(function()
            while _pulseActive do
                local tweenA, tweenB
                local ok = pcall(function()
                    tweenA = TweenService:Create(AccentBar,
                        TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                        { BackgroundTransparency = 0.55 })
                    tweenA:Play()
                    task.wait(1.2)

                    -- Kiểm tra ngay sau wait: nếu loop bị kill thì cancel tween và thoát
                    if not _pulseActive then
                        pcall(function() tweenA:Cancel() end)
                        return
                    end

                    tweenB = TweenService:Create(AccentBar,
                        TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                        { BackgroundTransparency = 0 })
                    tweenB:Play()
                    task.wait(1.2)
                end)

                -- Nếu loop bị dừng hoặc có lỗi thì cancel tween đang chạy dở và thoát
                if not _pulseActive then
                    pcall(function() if tweenA then tweenA:Cancel() end end)
                    pcall(function() if tweenB then tweenB:Cancel() end end)
                    break
                end
                if not ok then break end
            end
        end)
    end)
    print("[DRACO] " .. tostring(state) .. (extraText and (" | " .. extraText:gsub("\n", " ")) or ""))
end
