            writeState("RESET_BUYDRACO", { dh_mastery = dh, ds_mastery = ds, stat_reset = true })
            task.wait(1)
        else
            updateStatus(state, "Stat đã reset. Đang mua Draco...")
        end

        local bought = BuyDracoRace()
        if bought then
            writeState("FARM_V2V3", { stat_reset = true })
            task.wait(2)
            rejoin("Mua Draco xong → FARM_V2V3")
        else
            updateStatus(state, "Mua Draco thất bại, rejoin thử lại...")
            task.wait(3)
            rejoin("Retry mua Draco (stat đã reset, không tốn frag)")
        end

    else
        if dh < 500 then
            writeState("FARM_DH_MAS", { dh_mastery = dh, ds_mastery = ds, stat_reset = false })
        else
            writeState("FARM_DS_MAS", { dh_mastery = dh, ds_mastery = ds, stat_reset = false })
        end
        task.wait(1)
        rejoin("Mastery chưa đủ → về farm")
    end
end

if state == "FARM_V2V3" then
    executeConfig("FARM_V2V3")
end
