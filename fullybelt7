local function updateStatus(state, extraText)
    pcall(function()
        local icon = stateIcons[state] or ("📋 " .. tostring(state))
        StatusLabel.Text  = icon .. (extraText and ("\n" .. extraText) or "")
        StatusStroke.Color = stateColors[state] or Color3.fromRGB(88, 101, 242)
    end)
    print("[DRACO] " .. tostring(state) .. (extraText and (" | " .. extraText:gsub("\n", " ")) or ""))
end

local function readState()
    if isfile(stateFile) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(stateFile))
        end)
        if ok and type(data) == "table" and data.state then
            return data
        end
    end
    return nil
end

local function writeState(state, overrides)
    local existing = readState() or {}
    local data = {
        state            = state,
        dh_mastery       = (overrides and overrides.dh_mastery) or existing.dh_mastery or 0,
        ds_mastery       = (overrides and overrides.ds_mastery) or existing.ds_mastery or 0,
        has_dragon_talon = (overrides and overrides.has_dragon_talon ~= nil)
                            and overrides.has_dragon_talon
                            or (existing.has_dragon_talon == true),
        has_black_belt   = (overrides and overrides.has_black_belt ~= nil)
                            and overrides.has_black_belt
                            or (existing.has_black_belt == true),
    }
    writefile(stateFile, HttpService:JSONEncode(data))
    updateStatus(state)
end

local function safeInvoke(...)
    local args = {...}
    local result
    pcall(function() result = rs.Remotes.CommF_:InvokeServer(table.unpack(args)) end)
    return result
end

local function checkInventory(name)
    local found = false
    pcall(function()
        local inv = safeInvoke("getInventory")
        if inv then
            for _, item in pairs(inv) do
                if type(item) == "table" and item.Name == name then
                    found = true; return
                end
            end
        end
    end)
    return found
end

local function getItemCount(itemName)
    local count = 0
    pcall(function()
        local inv = safeInvoke("getInventory")
        if inv then
            for _, item in pairs(inv) do
                if type(item) == "table" and item.Name == itemName then
                    count = item.Count or 0; return
                end
            end
        end
    end)
    return count
end

local function checkMastery(weaponType, weaponName)
    local mas = 0
    pcall(function()
        local inv = safeInvoke("getInventory")
        if inv then
            for _, v in pairs(inv) do
                if type(v) == "table" and v.Type == weaponType and v.Name == weaponName then
                    mas = v.Mastery or 0; return
                end
            end
        end
    end)
    return mas
end

