local function readState()
    if isfile(stateFile) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(stateFile))
        end)
        if ok and type(data) == "table" and data.state then
            return data
        end
    end
    return nil
end

local function writeState(state, overrides)
    local existing = readState() or {}
    local data = {
        state            = state,
        dh_mastery       = (overrides and overrides.dh_mastery) or existing.dh_mastery or 0,
        ds_mastery       = (overrides and overrides.ds_mastery) or existing.ds_mastery or 0,
        has_dragon_talon = (overrides and overrides.has_dragon_talon ~= nil)
                            and overrides.has_dragon_talon
                            or (existing.has_dragon_talon == true),
        has_black_belt   = (overrides and overrides.has_black_belt ~= nil)
                            and overrides.has_black_belt
                            or (existing.has_black_belt == true),
        stat_reset       = (overrides and overrides.stat_reset ~= nil)
                            and overrides.stat_reset
                            or (existing.stat_reset == true),
        tether_retry     = (overrides and overrides.tether_retry ~= nil)
                            and overrides.tether_retry
                            or (existing.tether_retry or 0),
        bone_target      = (overrides and overrides.bone_target ~= nil)
                            and overrides.bone_target
                            or (existing.bone_target or 5),
    }
    writefile(stateFile, HttpService:JSONEncode(data))
    updateStatus(state)
end

local function safeInvoke(...)
    local args = {...}
    local result
    pcall(function() result = rs.Remotes.CommF_:InvokeServer(table.unpack(args)) end)
    return result
end

local CACHE_TTL  = 8
local invCache   = {}
local invCacheTs = 0

local function _refreshCache()
    local inv
    pcall(function() inv = safeInvoke("getInventory") end)
    if type(inv) ~= "table" then return end
    invCache = {}
    for _, item in pairs(inv) do
        if type(item) == "table" and item.Name then
            invCache[item.Name] = {
                count   = item.Count   or 1,
                mastery = item.Mastery or 0,
                itype   = item.Type    or "",
            }
        end
    end
    invCacheTs = tick()
end

local function _ensureCache()
    if tick() - invCacheTs > CACHE_TTL then
        _refreshCache()
    end
end

local function warmupInventoryCache()
    _refreshCache()
end

local function checkInventory(name)
    _ensureCache()
    return invCache[name] ~= nil
end

local function getItemCount(itemName)
    _ensureCache()
    local e = invCache[itemName]
    return e and e.count or 0
end

local function findWeaponLevel(weaponName)
    local locations = {
        workspace.Characters and workspace.Characters:FindFirstChild(playerName),
        lp.Character,
        lp.Backpack,
    }
    for _, container in ipairs(locations) do
        if container then
            local tool = container:FindFirstChild(weaponName)
            if tool then
                local lv = tool:FindFirstChild("Level")
                if lv then return lv, tool end
            end
        end
    end
    return nil, nil
end

local function checkMastery(weaponType, weaponName)
    local lv, _ = findWeaponLevel(weaponName)
    if lv then return lv.Value end
    _ensureCache()
    local e = invCache[weaponName]
    return (e and e.mastery) or 0
end

local masteryWatcherActive = {}

local function startWeaponMasteryWatcher(weaponType, weaponName, targetMastery, onReached, currentState)
    if masteryWatcherActive[weaponName] then return end
    masteryWatcherActive[weaponName] = true

    local triggered = false
    local uiState   = currentState or "FARM_DS_MAS"

    local function handleMastery(mas)
        if triggered then return end
        local dh = checkMastery("Sword", "Dragonheart")
        local ds = checkMastery("Gun",   "Dragonstorm")
        updateStatus(uiState, "DH: " .. dh .. "/500   DS: " .. ds .. "/500")
        if mas >= targetMastery then
            triggered = true
            masteryWatcherActive[weaponName] = false
            onReached(mas)
        end
    end

    task.spawn(function()
        task.wait(5)

        local currentConn = nil

        local function reconnect()
            if currentConn then pcall(function() currentConn:Disconnect() end); currentConn = nil end
            if triggered then return end
            local lv, _ = findWeaponLevel(weaponName)
            if not lv then return end
            handleMastery(lv.Value)
            currentConn = lv.Changed:Connect(function(newVal)
                handleMastery(newVal)
            end)
        end

        reconnect()

        local bpConn = lp.Backpack.ChildAdded:Connect(function(child)
            if child.Name == weaponName then task.wait(0.1); reconnect() end
        end)

        local function watchChar(char)
            if not char then return end
            char.ChildAdded:Connect(function(child)
                if child.Name == weaponName then task.wait(0.1); reconnect() end
            end)
        end

        local wsChars = workspace:FindFirstChild("Characters")
        if wsChars then
            local myChar = wsChars:FindFirstChild(playerName)
            if myChar then watchChar(myChar) end
            wsChars.ChildAdded:Connect(function(child)
                if child.Name == playerName then task.wait(1); watchChar(child); reconnect() end
            end)
        end

        lp.CharacterAdded:Connect(function(char)
            task.wait(1); watchChar(char); reconnect()
        end)

        while masteryWatcherActive[weaponName] do
            task.wait(10)
            pcall(function()
                if triggered then return end
                local lv, _ = findWeaponLevel(weaponName)
                if lv then
                    handleMastery(lv.Value)
                    if not currentConn then reconnect() end
                end
            end)
        end

        pcall(function() if currentConn then currentConn:Disconnect() end end)
        pcall(function() bpConn:Disconnect() end)
    end)
end
