function readState()
    if isfile(stateFile) then
        local content = readfile(stateFile)
        local success, data = pcall(function() return HttpService:JSONDecode(content) end)
        if success and data then return data end
    end
    return {state = "CHECK_PURPLE", data = {}}
end

function writeState(state, extraData)
    local data = {
        state = state,
        data = extraData or {},
        timestamp = os.time()
    }
    writefile(stateFile, HttpService:JSONEncode(data))
    updateStatusUI(state)
end

