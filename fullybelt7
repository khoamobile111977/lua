local monitorActive = false

local function startMonitoring(initState)
    if monitorActive then return end
    monitorActive = true

    if initState == "FARM_DS_MAS" then
        startWeaponMasteryWatcher("Gun", "Dragonstorm", 500, function(ds)
            local dh = checkMastery("Sword", "Dragonheart")
            if dh >= 500 then
                writeState("RESET_BUYDRACO", { dh_mastery = dh, ds_mastery = ds })
                task.wait(2)
                rejoin("DH+DS 500 → RESET_BUYDRACO")
            else
                writeState("FARM_DH_MAS", { dh_mastery = dh, ds_mastery = ds })
                task.wait(2)
                rejoin("DS 500 → FARM_DH_MAS")
            end
        end, "FARM_DS_MAS")
        return
    end

    if initState == "FARM_DH_MAS" then
        startWeaponMasteryWatcher("Sword", "Dragonheart", 500, function(dh)
            local ds = checkMastery("Gun", "Dragonstorm")
            if ds >= 500 then
                writeState("RESET_BUYDRACO", { dh_mastery = dh, ds_mastery = ds })
                task.wait(2)
                rejoin("DH+DS 500 → RESET_BUYDRACO")
            else
                writeState("FARM_DS_MAS", { dh_mastery = dh, ds_mastery = ds })
                task.wait(2)
                rejoin("DH 500 → FARM_DS_MAS")
            end
        end, "FARM_DH_MAS")
        return
    end

    local function checkStateTransition()
        local saved = readState()
        if not saved then return end
        local state = saved.state

        local bones = getItemCount("Dinosaur Bones")
        local eggs  = getItemCount("Dragon Egg")
        local scale = getItemCount("Dragon Scale")
        local ember = getItemCount("Blaze Ember")

        local extraText = ""
        if state == "FARM_DOJOTRAINER" then
            extraText = "Chờ Red Belt... (belt: " .. (hasDojoBelt("Red") and "GOT" or "waiting") .. ")"
        elseif state == "FARM_VOLCANO_DINOBONE" then
            local saved2     = readState()
            local boneTarget = (saved2 and saved2.bone_target) or 5
            extraText = "Bones: " .. bones .. "/" .. boneTarget
                .. (boneTarget > 5 and " (retry +" .. (boneTarget - 5) .. ")" or "")
        elseif state == "FARM_VOLCANO_EGG" then
            extraText = "Eggs: " .. eggs .. "/4"
        elseif state == "FARM_SCALE" then
            extraText = "Scale: " .. scale .. "/5"
        elseif state == "FARM_EMBER" then
            extraText = "Ember: " .. ember .. "/45"
        elseif state == "FARM_V2V3" then
            extraText = "Race: " .. getDracoRace()
        end
        updateStatus(state, extraText)

        if state == "FARM_DOJOTRAINER" then
            if hasDojoBelt("Red") then
                writeState("FARM_VOLCANO_DINOBONE")
                task.wait(2)
                rejoin("Có Red Belt → FARM_VOLCANO_DINOBONE")
            end

        elseif state == "FARM_VOLCANO_DINOBONE" then
            local saved2     = readState()
            local boneTarget = (saved2 and saved2.bone_target) or 5
            if bones >= boneTarget then
                writeState("GET_DAI8_TETHER")
                task.wait(2)
                rejoin("Đủ " .. boneTarget .. " Bones → GET_DAI8_TETHER")
            end

        elseif state == "FARM_VOLCANO_EGG" then
            if eggs >= 4 then
                local next = (scale >= 5) and ((ember >= 45) and "CRAFT_WEAPONS" or "FARM_EMBER") or "FARM_SCALE"
                writeState(next)
                task.wait(2)
                rejoin("Đủ Eggs → " .. next)
            end

        elseif state == "FARM_SCALE" then
            if scale >= 5 then
                local next = (ember >= 45) and "CRAFT_WEAPONS" or "FARM_EMBER"
                writeState(next)
                task.wait(2)
                rejoin("Đủ Scale → " .. next)
            end

        elseif state == "FARM_EMBER" then
            if ember >= 45 and scale >= 5 then
                writeState("CRAFT_WEAPONS")
                task.wait(2)
                rejoin("Đủ Ember → CRAFT_WEAPONS")
            end

        elseif state == "RESET_BUYDRACO" then
            if getDracoRace() == "Draco" then
                writeState("FARM_V2V3")
                task.wait(2)
                rejoin("Đã có Draco → FARM_V2V3")
            end
        end
    end

    task.spawn(function()
        task.wait(15)
        while monitorActive do
            pcall(checkStateTransition)
            task.wait(5)
        end
    end)
end


local function reverseCheck()
    updateStatus("CHECK_PURPLE", "Đang reverse check...")
    task.wait(5)

    local race      = getDracoRace()
    local hasDH     = checkInventory("Dragonheart")
    local hasDS     = checkInventory("Dragonstorm")
    local dh        = (hasDH or hasDS) and checkMastery("Sword", "Dragonheart") or 0
    local ds        = (hasDH or hasDS) and checkMastery("Gun",   "Dragonstorm") or 0
    local hasPurple = hasDojoBelt("Purple")
    local hasRed    = hasDojoBelt("Red")
    local hasBlack  = hasDojoBelt("Black")
    local bones     = getItemCount("Dinosaur Bones")
    local eggs      = getItemCount("Dragon Egg")
    local scale     = getItemCount("Dragon Scale")
    local ember     = getItemCount("Blaze Ember")

    updateStatus("CHECK_PURPLE",
        "Race:" .. race
        .. " | DH:" .. (hasDH and tostring(dh) or "x")
        .. " DS:" .. (hasDS and tostring(ds) or "x")
        .. "\nBelt:" .. (hasBlack and "Black" or hasRed and "Red" or hasPurple and "Purple" or "None")
        .. " Bones:" .. bones .. " Eggs:" .. eggs
        .. " Scale:" .. scale .. " Ember:" .. ember)
    task.wait(2)

    if race == "Draco" then
        writeState("FARM_V2V3")
        return "FARM_V2V3"
    end

    if hasDH and hasDS then
        if dh >= 500 and ds >= 500 then
            writeState("RESET_BUYDRACO", { dh_mastery = dh, ds_mastery = ds })
            return "RESET_BUYDRACO"
        elseif dh >= 500 then
            writeState("FARM_DS_MAS", { dh_mastery = dh, ds_mastery = ds })
            return "FARM_DS_MAS"
        elseif ds >= 500 then
            writeState("FARM_DH_MAS", { dh_mastery = dh, ds_mastery = ds })
            return "FARM_DH_MAS"
        else
            writeState("FARM_DS_MAS", { dh_mastery = dh, ds_mastery = ds })
            return "FARM_DS_MAS"
        end
    end

    if hasBlack then
        if eggs < 4 then
            writeState("FARM_VOLCANO_EGG")
            return "FARM_VOLCANO_EGG"
        end
        if scale < 5 then
            writeState("FARM_SCALE")
            return "FARM_SCALE"
        end
        if ember < 45 then
            writeState("FARM_EMBER")
            return "FARM_EMBER"
        end
        writeState("CRAFT_WEAPONS")
        return "CRAFT_WEAPONS"
    end

    if bones >= 5 then
        writeState("GET_DAI8_TETHER")
        return "GET_DAI8_TETHER"
    end

    if hasRed then
        writeState("FARM_VOLCANO_DINOBONE")
        return "FARM_VOLCANO_DINOBONE"
    end

    if hasPurple then
        writeState("FARM_DOJOTRAINER")
        return "FARM_DOJOTRAINER"
    end

    return "CHECK_PURPLE"
end

