        StatusLabel.Text = baseText .. "\n" .. extraText
    else
        StatusLabel.Text = baseText
    end
    
    -- Đổi màu stroke theo state
    if state:find("FARM") then
        UIStroke.Color = Color3.fromRGB(255, 165, 0)
    elseif state:find("CHECK") then
