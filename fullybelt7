function startMonitoring(currentStateType)
    task.spawn(function()
        task.wait(10)
        
        while wait(30) do
            local stateData = readState()
            local state = stateData.state
            
            -- 1. CHECK RED BELT khi đang farm DojoTrainer
            if state == "FARM_DOJOTRAINER" then
                if checkInventory("Dojo Belt (Red)") then
                    writeState("FARM_VOLCANO_DINOBONE")
                    task.wait(2)
                    game:GetService("TeleportService"):Teleport(game.PlaceId, lp)
                    break
                end
            end
            
            -- 2. CHECK DINOBONE
            if state == "FARM_VOLCANO_DINOBONE" then
                local bones = getItemCount("Dinosaur Bones")
                updateStatusUI(state, "🦴 " .. bones .. "/5 Dinobone")
                
                if bones >= 5 then
                    writeState("GET_DAI8_TETHER")
                    task.wait(2)
                    game:GetService("TeleportService"):Teleport(game.PlaceId, lp)
                    break
                end
            end
            
            -- 3. CHECK DRAGON EGG
            if state == "FARM_VOLCANO_EGG" then
                local eggs = getItemCount("Dragon Egg")
                updateStatusUI(state, "🥚 " .. eggs .. "/4 Dragon Egg")
                
                if eggs >= 4 then
                    writeState("CHECK_DRAGONEGG")
                    task.wait(30)
                    writeState("CRAFT_WEAPONS")
                    task.wait(2)
                    game:GetService("TeleportService"):Teleport(game.PlaceId, lp)
                    break
                end
            end
            
            if state == "FARM_SCALE" then
                local scale = getItemCount("Dragon Scale")
                updateStatusUI(state, "🐉 " .. scale .. "/5 Dragon Scale")
                
                if scale >= 5 then
                    local ember = getItemCount("Blaze Ember")
                    if ember >= 45 then
                        craftDragonWeapons()
                        resetStatTo("Gun", "Sword")
                        task.wait(2)
                        writeState("FARM_DS_MAS")
                        task.wait(2)
                        game:GetService("TeleportService"):Teleport(game.PlaceId, lp)
                        break
                    else
                        writeState("FARM_EMBER")
                        task.wait(2)
                        game:GetService("TeleportService"):Teleport(game.PlaceId, lp)
                        break
                    end
                end
            end
            
            if state == "FARM_EMBER" then
                local ember = getItemCount("Blaze Ember")
                updateStatusUI(state, "🔥 " .. ember .. "/45 Blaze Ember")
                
                if ember >= 45 then
