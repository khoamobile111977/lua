function determineInitialState()
    StarterGui:SetCore("SendNotification", {
        Title = "🔍 First Run", 
        Text = "Đang check ngược từ cao xuống thấp...", 
        Duration = 3
    })
    task.wait(2)
    
    -- BƯỚC 12: ĐÃ MUA DRACO? → FARM V2V3
    local currentRace = getCurrentRace()
    if currentRace == "Draco" then
        StarterGui:SetCore("SendNotification", {
            Title = "✅ Đã mua Draco!", 
            Text = "State: FARM_V2V3", 
            Duration = 3
        })
        return "FARM_V2V3"
    end
    
    -- BƯỚC 11: ĐỦ MASTERY? → MUA DRACO
    local hasDragonheart = checkInventory("Dragonheart")
    local hasDragonstorm = checkInventory("Dragonstorm")
    
    if hasDragonheart and hasDragonstorm then
        local dhMas = checkMastery("Sword", "Dragonheart")
        local dsMas = checkMastery("Gun", "Dragonstorm")
        
        StarterGui:SetCore("SendNotification", {
            Title = "🔍 Check Mastery", 
            Text = "DH: " .. dhMas .. " | DS: " .. dsMas, 
            Duration = 3
        })
        
        -- CẢ HAI ĐỦ 500 → MUA DRACO
        if dhMas >= 500 and dsMas >= 500 then
            StarterGui:SetCore("SendNotification", {
                Title = "✅ Đủ mastery!", 
                Text = "State: RESET_BUYDRACO", 
                Duration = 3
            })
            return "RESET_BUYDRACO"
        end
        
        -- BƯỚC 10: FARM MASTERY
        -- Ưu tiên farm Dragonstorm trước
        if dsMas < 500 then
            StarterGui:SetCore("SendNotification", {
                Title = "📍 DS chưa đủ", 
                Text = "State: FARM_DS_MAS (" .. dsMas .. "/500)", 
                Duration = 3
            })
            return "FARM_DS_MAS"
        else
            StarterGui:SetCore("SendNotification", {
                Title = "📍 DH chưa đủ", 
                Text = "State: FARM_DH_MAS (" .. dhMas .. "/500)", 
                Duration = 3
            })
            return "FARM_DH_MAS"
        end
    end
    
    -- BƯỚC 9: ĐÃ CÓ ĐỦ MATERIALS? → CRAFT WEAPONS
    local dragonScale = getItemCount("Dragon Scale")
    local blazeEmber = getItemCount("Blaze Ember")
    local dragonEggs = getItemCount("Dragon Egg")
    
    if dragonEggs >= 4 and dragonScale >= 5 and blazeEmber >= 45 then
        StarterGui:SetCore("SendNotification", {
            Title = "✅ Đủ materials!", 
            Text = "State: CRAFT_WEAPONS", 
            Duration = 3
        })
        return "CRAFT_WEAPONS"
    end
    
    -- BƯỚC 8: FARM EMBER
    if dragonEggs >= 4 and dragonScale >= 5 and blazeEmber < 45 then
        StarterGui:SetCore("SendNotification", {
            Title = "📍 Thiếu Blaze Ember", 
            Text = "State: FARM_EMBER (" .. blazeEmber .. "/45)", 
            Duration = 3
        })
        return "FARM_EMBER"
    end
    
    -- BƯỚC 7: FARM DRAGON SCALE
    if dragonEggs >= 4 and dragonScale < 5 then
        StarterGui:SetCore("SendNotification", {
            Title = "📍 Thiếu Dragon Scale", 
            Text = "State: FARM_SCALE (" .. dragonScale .. "/5)", 
            Duration = 3
        })
        return "FARM_SCALE"
    end
    
    -- BƯỚC 6: ĐÃ CÓ BLACK BELT? → FARM EGG
    local hasBlackBelt = checkInventory("Dojo Belt (Black)")
    if hasBlackBelt and dragonEggs < 4 then
        StarterGui:SetCore("SendNotification", {
            Title = "📍 Thiếu Dragon Egg", 
            Text = "State: FARM_VOLCANO_EGG (" .. dragonEggs .. "/4)", 
            Duration = 3
        })
