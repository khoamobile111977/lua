end

local function checkAndBuyTalonOnce()
    local saved = readState()
    if saved and saved.has_dragon_talon == true then
        getgenv().Melee = "Dragon Talon"
        return true
    end

    local hasTalon = hasDragonTalonInGame()
    if not hasTalon then
        hasTalon = buyDragonTalon()
    end

    writeState((saved and saved.state) or "FARM_V2V3", { has_dragon_talon = hasTalon })
    return hasTalon
end


