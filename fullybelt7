    local hasRedBelt = checkInventory("Dojo Belt (Red)")
    if hasRedBelt and dinoBones < 5 then
        StarterGui:SetCore("SendNotification", {
            Title = "📍 Thiếu Dinobone", 
            Text = "State: FARM_VOLCANO_DINOBONE (" .. dinoBones .. "/5)", 
            Duration = 3
