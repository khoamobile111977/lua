local function reverseCheck()
    updateStatus("FARM_V2V3", "🔍 Lần đầu chạy — Reverse check...")
    task.wait(3)

    local race = getDracoRace()
    if race == "Draco" then
        updateStatus("FARM_V2V3", "✅ Đã có Draco Race!")
        task.wait(1)
        writeState("FARM_V2V3")
        return "FARM_V2V3"
    end

    local dh = checkMastery("Sword", "Dragonheart")
    local ds = checkMastery("Gun",   "Dragonstorm")
    local hasDH = checkInventory("Dragonheart")
    local hasDS = checkInventory("Dragonstorm")

    if hasDH and hasDS then
        updateStatus("CRAFT_WEAPONS", "📊 DH: " .. dh .. " | DS: " .. ds)
        task.wait(1)

        if dh >= 500 and ds >= 500 then
            writeState("RESET_BUYDRACO", { dh_mastery = dh, ds_mastery = ds })
            return "RESET_BUYDRACO"
        elseif dh >= 500 then
            ensureInBackpack("Dragonstorm")
            writeState("FARM_DS_MAS", { dh_mastery = dh, ds_mastery = ds })
            return "FARM_DS_MAS"
        elseif ds >= 500 then
            ensureInBackpack("Dragonheart")
            writeState("FARM_DH_MAS", { dh_mastery = dh, ds_mastery = ds })
            return "FARM_DH_MAS"
        else
            ensureInBackpack("Dragonheart")
            ensureInBackpack("Dragonstorm")
            writeState("FARM_DS_MAS", { dh_mastery = dh, ds_mastery = ds })
            return "FARM_DS_MAS"
        end
    end

    local scale = getItemCount("Dragon Scale")
    local ember = getItemCount("Blaze Ember")
    local eggs  = getItemCount("Dragon Egg")
    local bones = getItemCount("Dinosaur Bones")

    updateStatus("CRAFT_WEAPONS",
        "🐉 Scale: " .. scale .. " | 🔥 Ember: " .. ember ..
        "\n🥚 Eggs: " .. eggs .. " | 🦴 Bones: " .. bones)
    task.wait(2)

    if scale >= 5 and ember >= 45 and eggs >= 4 then
        writeState("CRAFT_WEAPONS")
        return "CRAFT_WEAPONS"
    end

    if scale >= 5 and ember >= 45 then
        writeState("FARM_VOLCANO_EGG")
        return "FARM_VOLCANO_EGG"
    end

    if eggs >= 4 then
        if scale < 5 then
            writeState("FARM_SCALE")
            return "FARM_SCALE"
        else
            writeState("FARM_EMBER")
            return "FARM_EMBER"
        end
    end

    if scale >= 5 then
        writeState("FARM_EMBER")
        return "FARM_EMBER"
    end

    if bones >= 5 then
        if hasDojoBelt("Black") then
            writeState("FARM_VOLCANO_EGG")
            return "FARM_VOLCANO_EGG"
        else
            writeState("GET_DAI8_TETHER")
            return "GET_DAI8_TETHER"
        end
    end

    if hasDojoBelt("Red") then
        writeState("FARM_VOLCANO_DINOBONE")
        return "FARM_VOLCANO_DINOBONE"
    end

    if hasDojoBelt("Purple") then
        writeState("FARM_DOJOTRAINER")
        return "FARM_DOJOTRAINER"
    end

    writeState("CHECK_PURPLE")
    return "CHECK_PURPLE"
end

updateStatus("CHECK_PURPLE", "🚀 Khởi động...")
task.wait(3)

local savedData = readState()
