function TweenFruit()
    while getgenv().FullyDai5Running do
        local fruit = GetPathFruit()
        local char = lp.Character or lp.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart")
        
        if fruit and fruit:FindFirstChild("Handle") then
            local handle = fruit.Handle
            local distance = (handle.Position - hrp.Position).Magnitude
            
            if DroppedFruits[fruit.Name] then
                StarterGui:SetCore("SendNotification", {
                    Title = "Tween Fruit",
                    Text = "Bỏ qua fruit vừa drop: " .. fruit.Name,
                    Duration = 2
                })
                task.wait(3)
            elseif distance <= 1000 then
                StarterGui:SetCore("SendNotification", {
                    Title = "Tween Fruit",
                    Text = "Đã tìm thấy fruit: " .. fruit.Name .. " (khoảng cách: " .. math.floor(distance) .. "m)",
                    Duration = 3
                })
                
                TP1(handle.CFrame)
                repeat 
                    task.wait(0.5) 
                until (handle.Position - hrp.Position).Magnitude <= 50 or not fruit.Parent or not getgenv().FullyDai5Running
                
                if not getgenv().FullyDai5Running then
                    return false
                end
                
                task.wait(5)
        
                pcall(function()
                    if typeof(ClaimDojoQuest) == "function" then
                        ClaimDojoQuest()
                    end
                end)
                
                task.wait(2)
                
                if checkInventory("Dojo Belt (Blue)") then
                    StarterGui:SetCore("SendNotification", {
                        Title = "Fully Đai 5",
                        Text = "Đã có Dojo Belt (Blue)! Drop fruit và tắt Fully Đai 5...",
                        Duration = 5
                    })
                    
                    DropAllFruits()
                    task.wait(2)
                    
                    getgenv().FullyDai5Running = false
                    
                    StarterGui:SetCore("SendNotification", {
                        Title = "Fully Đai 5",
                        Text = "Đã hoàn thành! Tự động tắt.",
                        Duration = 5
                    })
                    
                    return true
                else
                    StarterGui:SetCore("SendNotification", {
                        Title = "Fully Đai 5",
                        Text = "Chưa có Dojo Belt (Blue), chuyển sang tìm tất cả fruit...",
                        Duration = 3
                    })
                    
                    DropAllFruits()
                    task.wait(2)
                    
                    return "switch_mode"
