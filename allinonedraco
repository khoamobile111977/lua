        fruit.EatRemote:InvokeServer(unpack(args))
        print("Đã drop:", fruitName)
        

        task.wait(1)
        

        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Tool") and v.Name == fruitName and v:FindFirstChild("Handle") then
