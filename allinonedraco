function ClaimDojoQuest()
	local found
	for _, container in ipairs({workspace:FindFirstChild("NPCs"), rs:FindFirstChild("NPCs")}) do
		if container then
			for _, npc in ipairs(container:GetChildren()) do
				if npc.Name == "Dojo Trainer" and npc:FindFirstChild("HumanoidRootPart") then
					found = npc
					break
				end
			end
		end
		if found then break end
	end

	if found and found:FindFirstChild("HumanoidRootPart") then
		TP1(CFrame.new(found.HumanoidRootPart.Position))
		local char = lp.Character or lp.CharacterAdded:Wait()
		local hrp = char:WaitForChild("HumanoidRootPart")
		repeat task.wait() until (hrp.Position - found.HumanoidRootPart.Position).Magnitude <= 5
		pcall(function()
			local args = {
				[1] = {
					NPC = "Dojo Trainer",
					Command = "ClaimQuest"
				}
			}
			rs:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RF/InteractDragonQuest"):InvokeServer(unpack(args))
		end)
		return true
	else
		StarterGui:SetCore("SendNotification", {
			Title = "Dojo Trainer",
			Text = "Không tìm thấy Dojo Trainer",
			Duration = 3
		})
		return false
	end
end


function GetPathFruit()
    for _, v in next, workspace:GetChildren() do
        if v:IsA("Tool") or v:IsA("Model") then
            if string.find(v.Name, "Fruit") then

                if not DroppedFruits[v.Name] and not string.find(v.Name, "_DROPPED_") then
                    return v
                end
            end
        end
    end
    return nil
end


function TweenFruit()
    local fruit = GetPathFruit()
    local char = lp.Character or lp.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    if fruit and fruit:FindFirstChild("Handle") then
        local handle = fruit.Handle
		if (handle.Position - hrp.Position).Magnitude <= 5 then
            pcall(function()
                firetouchinterest(handle, hrp, 0)
                firetouchinterest(handle, hrp, 1)
            end)
			task.wait(1)
			pcall(function()
				if typeof(ClaimDojoQuest) == "function" then
					ClaimDojoQuest()
				end
			end)
        else
            TP1(handle.CFrame)
            repeat task.wait() until (handle.Position - hrp.Position).Magnitude <= 5 or not fruit.Parent
            pcall(function()
                if handle.Parent then
                    firetouchinterest(handle, hrp, 0)
                    firetouchinterest(handle, hrp, 1)
                end
            end)
	
			pcall(function()
				if typeof(ClaimDojoQuest) == "function" then
					ClaimDojoQuest()
				end
			end)
        end
    else
        StarterGui:SetCore("SendNotification", {
            Title = "Tween Fruit",
            Text = "Không tìm thấy fruit",
            Duration = 3
        })
    end
end

