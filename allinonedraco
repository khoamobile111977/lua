function ClaimDojoQuest()
	local found
	for _, container in ipairs({workspace:FindFirstChild("NPCs"), rs:FindFirstChild("NPCs")}) do
		if container then
			for _, npc in ipairs(container:GetChildren()) do
				if npc.Name == "Dojo Trainer" and npc:FindFirstChild("HumanoidRootPart") then
					found = npc
					break
				end
			end
		end
		if found then break end
	end

	if found and found:FindFirstChild("HumanoidRootPart") then
		TP1(CFrame.new(found.HumanoidRootPart.Position))
		local char = lp.Character or lp.CharacterAdded:Wait()
		local hrp = char:WaitForChild("HumanoidRootPart")
		repeat task.wait() until (hrp.Position - found.HumanoidRootPart.Position).Magnitude <= 5
		pcall(function()
			local args = {
				[1] = {
					NPC = "Dojo Trainer",
					Command = "ClaimQuest"
				}
			}
			rs:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RF/InteractDragonQuest"):InvokeServer(unpack(args))
		end)
		return true
	else
		StarterGui:SetCore("SendNotification", {
			Title = "Dojo Trainer",
			Text = "Không tìm thấy Dojo Trainer",
			Duration = 3
		})
		return false
	end
end


