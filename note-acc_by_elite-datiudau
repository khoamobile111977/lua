local noteBox = Instance.new("TextBox")
noteBox.Size = UDim2.new(1, -20, 0, 70)
noteBox.Position = UDim2.new(0, 10, 0, 70)
noteBox.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
noteBox.TextColor3 = Color3.fromRGB(30, 30, 30)
noteBox.Font = Enum.Font.Gotham
noteBox.TextSize = 18
noteBox.TextWrapped = true
noteBox.TextXAlignment = Enum.TextXAlignment.Left
noteBox.TextYAlignment = Enum.TextYAlignment.Top
noteBox.ClearTextOnFocus = false
noteBox.PlaceholderText = "Ghi chú tại đây..."
noteBox.ZIndex = 10001
Instance.new("UICorner", noteBox).CornerRadius = UDim.new(0, 8)
Instance.new("UIPadding", noteBox).PaddingLeft = UDim.new(0, 8)
Instance.new("UIPadding", noteBox).PaddingTop = UDim.new(0, 8)
noteBox.Parent = frame

local fileName = "note_" .. player.Name .. ".txt"
if isfile and isfile(fileName) then
	noteBox.Text = readfile(fileName)
end
noteBox.FocusLost:Connect(function()
	if writefile then
		writefile(fileName, noteBox.Text)
	end
end)

frame.Position = UDim2.new(0.5, 0, -0.3, 0)
frame.BackgroundTransparency = 1
TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
	Position = UDim2.new(0.5, 0, 0, 0),
	BackgroundTransparency = 0
}):Play()

local visible = true
local tweenTime = 0.5
local hiding = false

local function setElementsTransparency(val)
	for _, obj in pairs(frame:GetDescendants()) do
		if obj:IsA("TextLabel") or obj:IsA("TextBox") then
			obj.TextTransparency = val
			if obj:IsA("TextBox") then
				obj.BackgroundTransparency = val
			end
		end
	end
end

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.P and not hiding then
		hiding = true
		visible = not visible

		if not visible then
			local tweenOut = TweenService:Create(frame, TweenInfo.new(tweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
				Position = UDim2.new(0.5, 0, -0.3, 0),
				BackgroundTransparency = 1
			})
			tweenOut:Play()
			setElementsTransparency(1)
			tweenOut.Completed:Wait()
			frame.Visible = false
		else
			frame.Position = UDim2.new(0.5, 0, -0.3, 0)
			frame.BackgroundTransparency = 1
			setElementsTransparency(1)
			frame.Visible = true
			local tweenIn = TweenService:Create(frame, TweenInfo.new(tweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = UDim2.new(0.5, 0, 0, 0),
				BackgroundTransparency = 0
			})
			tweenIn:Play()
			tweenIn.Completed:Wait()
			setElementsTransparency(0)
		end
		hiding = false
	end
end)
