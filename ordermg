-- Hàm tải và hiển thị đơn hàng
function loadOrders()
    if debounce then return end
    debounce = true
    
    statusLabel.Text = "📋 Trạng thái: Đang tải..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 223, 88)
    
    -- Xóa tất cả order cũ
    for _, child in pairs(orderScrollFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    spawn(function()
        local orderData = callAPI(API_CONFIG.ENDPOINTS.GET_ORDERS, LocalPlayer.Name)
        
        if orderData and orderData.success and orderData.orders then
            local orders = orderData.orders
            if type(orders) == "string" then
                orders = {orders}
            end
            
            if #orders > 0 then
                statusLabel.Text = "📋 Trạng thái: Tìm thấy " .. #orders .. " đơn hàng"
                statusLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
                
                for i, order in ipairs(orders) do
                    local isCompleted = completedOrders[i] or false
                    createOrderItem(order, i, isCompleted)
                end
                
                showNotification("✅ Thành công", "Đã tải " .. #orders .. " đơn hàng!", Color3.fromRGB(46, 204, 113))
            else
                statusLabel.Text = "📋 Trạng thái: Không có đơn hàng"
                statusLabel.TextColor3 = Color3.fromRGB(231, 76, 60)
                showNotification("❌ Không có đơn", "Không tìm thấy đơn hàng", Color3.fromRGB(231, 76, 60))
            end
        else
            statusLabel.Text = "📋 Trạng thái: Lỗi kết nối API"
            statusLabel.TextColor3 = Color3.fromRGB(231, 76, 60)
            showNotification("🔌 Lỗi kết nối", "Không thể kết nối đến server API", Color3.fromRGB(231, 76, 60))
        end
        
        wait(1)
        debounce = false
    end)
end

-- Hàm xóa workspace
local function clearWorkspace()
    local success, error = pcall(function()
        if isfile(SAVE_FILE) then
            delfile(SAVE_FILE)
        end
    end)
    
    if success then
        completedOrders = {}
        showNotification("🗑️ Đã xóa workspace", "File lưu trữ đã được xóa", Color3.fromRGB(231, 76, 60))
        loadOrders() -- Reload để cập nhật UI
    else
        warn("Lỗi khi xóa workspace: " .. tostring(error))
    end
end

