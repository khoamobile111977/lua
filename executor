local function setStatus(text, color)
    statusLabel.Text = text
    statusLabel.TextColor3 = color
    ts:Create(statusLabel, TweenInfo.new(0.3), {
        TextTransparency = 0
    }):Play()
    
    task.wait(3)
    
    ts:Create(statusLabel, TweenInfo.new(0.5), {
        TextTransparency = 0
    }):Play()
    task.wait(0.5)
    statusLabel.Text = "Ready"
    statusLabel.TextColor3 = COLORS.success
end

executeBtn.MouseButton1Click:Connect(function()
    local code = codeBox.Text
    
    if code == "" or code == "-- Paste your script here\nprint('Hello World!')" then
        setStatus("⚠ No code to execute", COLORS.error)
        return
    end
    
    setStatus("⚡ Executing...", COLORS.accent)
    
    local success, err = pcall(function()
        local func, loadErr = loadstring(code)
        if not func then
            error(loadErr)
        end
        func()
    end)
    
    if success then
        setStatus("✓ Executed successfully", COLORS.success)
    else
        setStatus("✗ Error: " .. tostring(err), COLORS.error)
        warn("Executor Error:", err)
    end
end)

clearBtn.MouseButton1Click:Connect(function()
    codeBox.Text = ""
    setStatus("✓ Cleared", COLORS.success)
end)

copyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(codeBox.Text)
        setStatus("✓ Copied to clipboard", COLORS.success)
    else
        setStatus("✗ Clipboard not supported", COLORS.error)
    end
end)

local dragging, dragInput, dragStart, startPos

local function update(input)
    local delta = input.Position - dragStart
    mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then update(input) end
end)

local uiVisible = true
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.Delete and not gameProcessed then
        uiVisible = not uiVisible
        mainFrame.Visible = uiVisible
        
        if uiVisible then
            ts:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 600, 0, 400)
            }):Play()
        end
    end
end)

mainFrame.Size = UDim2.new(0, 0, 0, 0)
ts:Create(mainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
    Size = UDim2.new(0, 600, 0, 400)
}):Play()

