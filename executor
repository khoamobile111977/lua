local function updateEditor()
    local text = codeBox.Text
    local lines = 1
    for _ in text:gmatch("\n") do
        lines = lines + 1
    end

    local textHeight = math.max(300, lines * 18 + 20)

    codeScroll.CanvasSize = UDim2.new(0, 0, 0, textHeight)
    lineNumberScroll.CanvasSize = UDim2.new(0, 0, 0, textHeight)
    
    codeBox.Size = UDim2.new(1, -10, 0, textHeight)

    local lineText = ""
    for i = 1, lines do
        lineText = lineText .. i .. "\n"
    end
    lineNumbers.Text = lineText
    lineNumbers.Size = UDim2.new(1, 0, 0, textHeight)
end

codeBox:GetPropertyChangedSignal("Text"):Connect(function()
    updateEditor()
end)

updateEditor()

